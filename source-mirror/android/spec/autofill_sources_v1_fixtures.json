    {
      "name": "priority_top_level_modules_external",
      "input": {
        "host_entry_id": "host-priority",
        "entries": [
          {
            "id": "host-priority",
            "type": "login",
            "title": "Priority host",
            "fields": {
              "username": "host-user",
              "autofill_links": [
                {
                  "id": "link-priority",
                  "source_entry_id": "external-priority",
                  "fields": [
                    {
                      "module_id": "external-login",
                      "source_key": "username",
                      "role": "username",
                      "requires_verification": false
                    },
                    {
                      "module_id": "external-email",
                      "source_key": "value",
                      "role": "email",
                      "requires_verification": false
                    },
                    {
                      "module_id": "external-phone",
                      "source_key": "value",
                      "role": "phone",
                      "requires_verification": false
                    }
                  ]
                }
              ]
            },
            "modules": [
              {
                "id": "host-login",
                "type": "login_account",
                "title": "Host account",
                "fields": {
                  "username": "module-user"
                },
                "config": {}
              },
              {
                "id": "host-email",
                "type": "email",
                "title": "Host email",
                "fields": {
                  "value": "module@example.test"
                },
                "config": {}
              }
            ]
          },
          {
            "id": "external-priority",
            "type": "contact",
            "title": "Priority external",
            "fields": {},
            "modules": [
              {
                "id": "external-login",
                "type": "login_account",
                "title": "External account",
                "fields": {
                  "username": "external-user"
                },
                "config": {}
              },
              {
                "id": "external-email",
                "type": "email",
                "title": "External email",
                "fields": {
                  "value": "external@example.test"
                },
                "config": {}
              },
              {
                "id": "external-phone",
                "type": "phone",
                "title": "External phone",
                "fields": {
                  "value": "+1-555-0100"
                },
                "config": {}
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "role": "username",
          "source_entry_id": "host-priority",
          "module_id": null,
          "source_key": "username",
          "value": "host-user",
          "requires_verification": false
        },
        {
          "role": "email",
          "source_entry_id": "host-priority",
          "module_id": "host-email",
          "source_key": "value",
          "value": "module@example.test",
          "requires_verification": false
        },
        {
          "role": "phone",
          "source_entry_id": "external-priority",
          "module_id": "external-phone",
          "source_key": "value",
          "value": "+1-555-0100",
          "requires_verification": false
        }
      ],
      "expected_issues": [
        "ROLE_SHADOWED",
        "ROLE_SHADOWED",
        "ROLE_SHADOWED"
      ]
