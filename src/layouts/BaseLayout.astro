---
import { absoluteUrl, SITE_NAME, SITE_NAME_CN, withBaseAsset } from "../config/site";
import { localeMeta, localePath, otherLocale, uiText, type Locale } from "../i18n/config";
import { ClientRouter } from "astro:transitions";

interface Props {
    locale: Locale;
    title: string;
    description: string;
    routePath?: string;
}

const { locale, title, description, routePath = "/" } = Astro.props;
const alternate = otherLocale(locale);
const text = uiText[locale];
const brandName = locale === "zh-cn" ? SITE_NAME_CN : SITE_NAME;
const canonical = absoluteUrl(`/${locale}${routePath === "/" ? "" : routePath}/`);
const year = new Date().getFullYear();
const menuLabel = locale === "zh-cn" ? "打开菜单" : "Open menu";
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f9fc" />
        <link rel="icon" href={withBaseAsset("/favicon.ico")} sizes="any" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={localeMeta[locale].htmlLang} href={canonical} />
        <link rel="alternate" hreflang={localeMeta[alternate].htmlLang} href={absoluteUrl(`/${alternate}${routePath === "/" ? "" : routePath}/`)} />
        <title>{title} · {brandName}</title>
        <ClientRouter />
    </head>
    <body>
        <canvas id="dot-grid" aria-hidden="true" transition:persist="dot-grid"></canvas>
        <a class="skip-link" href="#main">{text.skipToContent}</a>
        <header class="site-header" id="siteHeader">
            <div class="container nav">
                <a class="brand" href={localePath(locale)} aria-label={`${brandName} ${text.nav.home}`}>
                    <span class="brand-mark" aria-hidden="true">
                        <img src={withBaseAsset("/favicon.ico")} alt="" width="24" height="24" />
                    </span>
                    <span>{brandName}</span>
                </a>
                <nav class="nav-links" id="navLinks" aria-label="Primary">
                    <a href={localePath(locale)}>{text.nav.home}</a>
                    <a href={localePath(locale, "download")}>{text.nav.download}</a>
                    <a href={localePath(locale, "journey")}>{text.nav.journey}</a>
                    <a href={localePath(locale, "security")}>{text.nav.security}</a>
                    <a href={localePath(locale, "support")}>{text.nav.support}</a>
                </nav>
                <div class="nav-actions">
                    <a class="language-switch" href={localePath(alternate, routePath)} hreflang={localeMeta[alternate].htmlLang}>{text.switchLanguage}</a>
                    <a class="btn btn-primary nav-cta" href={localePath(locale, "download")}>
                        {text.nav.download}
                        <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </a>
                    <button class="menu-button" id="menuButton" aria-label={menuLabel} aria-expanded="false">
                        <span></span>
                    </button>
                </div>
            </div>
        </header>
        <main id="main" transition:animate="fade"><slot /></main>
        <footer class="site-footer">
            <div class="container footer-grid">
                <div class="footer-brand-col">
                    <a href={localePath(locale)} class="brand">
                        <span class="brand-mark" aria-hidden="true">
                            <img src={withBaseAsset("/favicon.ico")} alt="" width="24" height="24" loading="lazy" />
                        </span>
                        <span>{brandName}</span>
                    </a>
                    <p class="footer-copy">
                        {locale === "zh-cn" ? "为更安静的数字安全而设计。" : "Designed for calmer digital security."}<br />
                        © {year} {brandName}. All rights reserved.
                    </p>
                    <a class="footer-badges" href="https://github.com/faegit/faevault-site" target="_blank" rel="noopener noreferrer">
                        <img src="https://img.shields.io/github/stars/faegit/faevault-site?style=social" alt="GitHub Stars" loading="lazy" />
                        <img src="https://img.shields.io/github/forks/faegit/faevault-site?style=social" alt="GitHub Forks" loading="lazy" />
                    </a>
                </div>
                <nav class="footer-links" aria-label="Footer">
                    <a href={localePath(locale)}>{text.nav.home}</a>
                    <a href={localePath(locale, "download")}>{text.nav.download}</a>
                    <a href={localePath(locale, "journey")}>{text.nav.journey}</a>
                    <a href={localePath(locale, "security")}>{text.nav.security}</a>
                    <a href={localePath(locale, "support")}>{text.nav.support}</a>
                </nav>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        color-scheme: light;
        --bg: #f7f9fc;
        --panel: rgba(255, 255, 255, 0.78);
        --panel-solid: #ffffff;
        --text: #111827;
        --text-soft: #5f6b7a;
        --text-muted: #8792a2;
        --line: rgba(15, 23, 42, 0.08);
        --brand: #2f6fed;
        --brand-2: #6d8cff;
        --brand-deep: #1d4fb8;
        --brand-soft: #eaf1ff;
        --success: #168a61;
        --success-soft: #e8f7f0;
        --shadow: 0 24px 80px rgba(35, 52, 86, 0.12);
        --shadow-soft: 0 14px 44px rgba(35, 52, 86, 0.08);
        --radius-xl: 32px;
        --radius-lg: 24px;
        --radius-md: 18px;
        --container: 1180px;
        --font-sans: "SF Pro Display", "SF Pro Text", "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, "Segoe UI", sans-serif;
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
    }
    ::selection {
        background: rgba(47, 111, 237, 0.16);
    }
    body {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }
    body.copy-enabled,
    body.copy-enabled * {
        -webkit-user-select: text;
        -moz-user-select: text;
        -ms-user-select: text;
        user-select: text;
        -webkit-touch-callout: default;
    }
    #dot-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        width: 100vw;
        height: 100vh;
    }
    * {
        box-sizing: border-box;
    }
    html {
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
        overflow-x: hidden;
    }
    body {
        margin: 0;
        min-width: 320px;
        overflow-x: hidden;
        color: var(--text);
        background:
            radial-gradient(circle at 12% 6%, rgba(92, 130, 255, 0.10), transparent 28%),
            radial-gradient(circle at 88% 18%, rgba(55, 199, 169, 0.08), transparent 26%),
            linear-gradient(180deg, #fbfcff 0%, var(--bg) 58%, #f4f7fb 100%);
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    button {
        cursor: pointer;
        font: inherit;
    }
    .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.65rem 1rem;
        border-radius: 999px;
        background: #16233f;
        color: #fff;
        transform: translateY(-160%);
    }
    .skip-link:focus {
        transform: translateY(0);
    }
    .container {
        width: min(calc(100% - 40px), 1200px);
        margin: 0 auto;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 46px;
        padding: 0 18px;
        border: 0;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 750;
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            background 160ms ease;
    }
    .btn:hover {
        transform: translateY(-1px);
    }
    .btn-primary {
        color: #fff;
        background: linear-gradient(145deg, #1a3a6e 0%, #0f2850 100%);
        box-shadow: 0 12px 24px rgba(15, 30, 65, 0.28);
    }
    .btn-primary:hover {
        box-shadow: 0 15px 30px rgba(15, 30, 65, 0.35);
    }
    .btn-secondary {
        color: #2f3a4a;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 6px 18px rgba(30, 41, 59, 0.04);
    }
    .btn-large {
        min-height: 54px;
        padding: 0 22px;
        border-radius: 16px;
        font-size: 15px;
    }
    .arrow {
        width: 16px;
        height: 16px;
        transition: transform 160ms ease;
    }
    .btn:hover .arrow {
        transform: translateX(2px);
    }
    .eyebrow-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        padding: 8px 12px;
        border: 1px solid rgba(47, 111, 237, 0.12);
        border-radius: 999px;
        color: var(--brand);
        background: rgba(255, 255, 255, 0.72);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--brand);
        box-shadow: 0 0 0 5px rgba(47, 111, 237, 0.08);
    }
    [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition:
            opacity 650ms ease,
            transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    [data-reveal].visible {
        opacity: 1;
        transform: translateY(0);
    }

    .site-header {
        position: fixed;
        z-index: 50;
        top: 0;
        left: 0;
        right: 0;
        padding: 14px 0;
        transition: 220ms ease;
    }
    .site-header.scrolled {
        background: rgba(248, 250, 253, 0.82);
        border-bottom: 1px solid rgba(15, 23, 42, 0.06);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }
    .site-header .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 48px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
    }
    .brand-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        overflow: hidden;
    }
    .brand-mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
        color: #465162;
        font-size: 14px;
        font-weight: 650;
    }
    .nav-links a {
        transition: color 160ms ease;
    }
    .nav-links a:hover {
        color: var(--brand);
    }
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .language-switch {
        padding: 0 8px;
        color: #526074;
        font-size: 13.5px;
        font-weight: 650;
        transition: color 160ms ease;
    }
    .language-switch:hover {
        color: var(--brand);
    }
    .menu-button {
        display: none;
        width: 42px;
        height: 42px;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.78);
    }
    .menu-button span,
    .menu-button::before,
    .menu-button::after {
        content: "";
        display: block;
        width: 18px;
        height: 2px;
        margin: 4px auto;
        border-radius: 2px;
        background: #273244;
        transition: 180ms ease;
    }
    .menu-button.open span {
        opacity: 0;
    }
    .menu-button.open::before {
        transform: translateY(6px) rotate(45deg);
    }
    .menu-button.open::after {
        transform: translateY(-6px) rotate(-45deg);
    }

    main {
        position: relative;
        z-index: 1;
        min-height: 80vh;
        max-width: 100vw;
        overflow-x: hidden;
    }
    .site-footer {
        position: relative;
        z-index: 1;
        padding: 42px 0 54px;
    }
    .footer-grid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
    }
    .footer-copy {
        margin: 12px 0 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.7;
    }
    .footer-badges {
        display: inline-flex;
        gap: 0.6rem;
        align-items: center;
        margin-top: 12px;
        opacity: 0.75;
        transition: opacity 0.25s ease;
    }
    .footer-badges:hover {
        opacity: 1;
    }
    .footer-badges img {
        height: 20px;
    }
    .footer-links {
        display: flex;
        gap: 20px;
        color: #657083;
        font-size: 12px;
        font-weight: 650;
    }
    .footer-links a:hover {
        color: var(--brand);
    }

    ::view-transition-old(root) {
        animation: 0.22s ease both crossfade-out;
    }
    ::view-transition-new(root) {
        animation: 0.24s ease 0.06s both crossfade-in;
        mix-blend-mode: normal;
    }
    @keyframes crossfade-out {
        to {
            opacity: 0;
        }
    }
    @keyframes crossfade-in {
        from {
            opacity: 0;
        }
    }
    @media (max-width: 980px) {
        .nav-links {
            position: absolute;
            top: 70px;
            left: 20px;
            right: 20px;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 5px;
            padding: 12px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: var(--shadow-soft);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .nav-links.open {
            display: flex;
        }
        .nav-links a {
            padding: 12px 14px;
            border-radius: 10px;
        }
        .nav-links a:hover {
            background: var(--brand-soft);
        }
        .menu-button {
            display: block;
        }
        .language-switch {
            display: none;
        }
    }
    @media (max-width: 520px) {
        .container {
            width: calc(100% - 26px);
        }
        .nav-cta {
            display: none;
        }
        .footer-grid {
            align-items: flex-start;
            flex-direction: column;
        }
        .footer-links {
            flex-wrap: wrap;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

<script>
    function updateHeaderState() {
        const header = document.getElementById("siteHeader");
        if (header) header.classList.toggle("scrolled", window.scrollY > 18);
    }
    window.addEventListener("scroll", updateHeaderState, { passive: true });

    function initChrome() {
        updateHeaderState();
        const menuButton = document.getElementById("menuButton");
        const navLinks = document.getElementById("navLinks");
        if (!menuButton || !navLinks || menuButton.dataset.menuReady === "true") return;
        menuButton.dataset.menuReady = "true";
        const setMenuState = (open: boolean) => {
            menuButton.classList.toggle("open", open);
            navLinks.classList.toggle("open", open);
            menuButton.setAttribute("aria-expanded", String(open));
            menuButton.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
        };
        menuButton.addEventListener("click", () => {
            setMenuState(!navLinks.classList.contains("open"));
        });
        navLinks.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => setMenuState(false));
        });
        document.addEventListener("click", (e) => {
            if (!navLinks.classList.contains("open")) return;
            if (!menuButton.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
                setMenuState(false);
            }
        });
    }

    function initReveal() {
        const items = document.querySelectorAll("[data-reveal]:not(.visible)");
        if (!items.length) return;
        if (!("IntersectionObserver" in window)) {
            items.forEach((item) => item.classList.add("visible"));
            return;
        }
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.12, rootMargin: "0px 0px -30px 0px" },
        );
        items.forEach((item) => observer.observe(item));
    }

    function initCopyGuard() {
        if (document.body.dataset.copyGuardReady === "true") return;
        document.body.dataset.copyGuardReady = "true";
        const isTextField = (el: EventTarget | null) =>
            el instanceof HTMLElement && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable);
        const block = (e: Event) => {
            if (document.body.classList.contains("copy-enabled")) return;
            if (isTextField(e.target)) return;
            e.preventDefault();
        };
        document.addEventListener("copy", block);
        document.addEventListener("cut", block);
        document.addEventListener("contextmenu", block);
        document.addEventListener("selectstart", block);
        document.addEventListener("dragstart", block);
    }

    document.addEventListener("astro:page-load", () => {
        initChrome();
        initReveal();
        initCopyGuard();
    });
    initChrome();
    initReveal();
    initCopyGuard();

    (function () {
        const canvas = document.getElementById("dot-grid") as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.gridReady) return;
        canvas.dataset.gridReady = "true";
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const SPACING = 38;
        const BASE_R = 0.8;
        const MAX_R = 3.0;
        const INFLUENCE = 140;
        const RIPPLE_SPEED = 0.14;
        const RIPPLE_GAP = 160;
        const RIPPLE_BAND = 46;
        const LINE_ALPHA = 0.055;
        const LINE_COLOR = "108, 132, 235";
        type Node = { x: number; y: number; r: number };
        let w = 0;
        let h = 0;
        let nodes: Node[] = [];
        let mx = -9999;
        let my = -9999;

        function resize() {
            w = canvas!.width = window.innerWidth;
            h = canvas!.height = window.innerHeight;
            canvas!.style.width = `${w}px`;
            canvas!.style.height = `${h}px`;
            nodes = [];
            for (let y = 0; y <= h + SPACING; y += SPACING)
                for (let x = 0; x <= w + SPACING; x += SPACING) nodes.push({ x, y, r: BASE_R });
        }

        function drawLines() {
            ctx!.strokeStyle = `rgba(${LINE_COLOR}, ${LINE_ALPHA})`;
            ctx!.lineWidth = 1;
            for (let x = 0; x <= w + SPACING; x += SPACING) {
                ctx!.beginPath();
                ctx!.moveTo(x, 0);
                ctx!.lineTo(x, h);
                ctx!.stroke();
            }
            for (let y = 0; y <= h + SPACING; y += SPACING) {
                ctx!.beginPath();
                ctx!.moveTo(0, y);
                ctx!.lineTo(w, y);
                ctx!.stroke();
            }
        }

        function draw(now = 0) {
            ctx!.clearRect(0, 0, w, h);
            drawLines();
            const centerX = w / 2;
            const centerY = h / 2;
            const rippleCycle = Math.hypot(centerX, centerY) + RIPPLE_GAP * 2;
            const leadingRadius = (now * RIPPLE_SPEED) % rippleCycle;
            for (const n of nodes) {
                const dx = mx - n.x;
                const dy = my - n.y;
                let t = 1 - Math.sqrt(dx * dx + dy * dy) / INFLUENCE;
                if (t < 0) t = 0;
                const centerDist = Math.hypot(n.x - centerX, n.y - centerY);
                const rippleDelta = centerDist - leadingRadius;
                const ripple =
                    leadingRadius > 0 ? Math.exp(-(rippleDelta * rippleDelta) / (2 * RIPPLE_BAND * RIPPLE_BAND)) : 0;
                const target = BASE_R + (MAX_R - BASE_R) * t * t + ripple * 1.8;
                n.r += (target - n.r) * (prefersReduced ? 1 : 0.10);
                const alpha = 0.18 + ripple * 0.22 + t * 0.15;
                ctx!.beginPath();
                ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                ctx!.fillStyle = `rgba(${LINE_COLOR}, ${Math.min(alpha, 0.55)})`;
                ctx!.fill();
            }
            if (!prefersReduced) requestAnimationFrame(draw);
        }

        function drawStatic() {
            ctx!.clearRect(0, 0, w, h);
            drawLines();
            for (const n of nodes) {
                ctx!.beginPath();
                ctx!.arc(n.x, n.y, BASE_R, 0, Math.PI * 2);
                ctx!.fillStyle = `rgba(${LINE_COLOR}, 0.18)`;
                ctx!.fill();
            }
        }

        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                resize();
                if (prefersReduced) drawStatic();
            }, 120);
        });
        document.addEventListener("mousemove", (e) => {
            mx = e.clientX;
            my = e.clientY;
        });
        document.addEventListener("mouseleave", () => {
            mx = -9999;
            my = -9999;
        });
        resize();
        prefersReduced ? drawStatic() : draw();
    })();
</script>
