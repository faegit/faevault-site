    }
    .workflow-dot {
        display: inline-block;
        width: 0.72rem;
        height: 0.72rem;
        margin-bottom: 0.95rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #72c3db, #2c7695);
        box-shadow: 0 0 0 4px rgba(42, 118, 149, 0.16);
    }
