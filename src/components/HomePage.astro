---
import type { Locale } from "../i18n/config";
import { localePath } from "../i18n/config";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const productImage = (name: string) => `${import.meta.env.BASE_URL}images/product/${name}`;
const copy =
    locale === "zh-cn"
        ? {
              eyebrow: "",
              title: "你的密码和数据，完全由你掌控。",
              intro: "保险库在 Android 设备上管理登录、银行卡、身份证、Wi-Fi 与 API 密钥，并将数据保存到本地加密的 .pmv 文件。",
              storyLink: "了解产品故事",

              storyKicker: "数据如何保存",
              storyTitle: "本地优先 · 加密落盘",
              storyBody:
                  "保险库默认把数据保存在设备内的加密文件中，不提供开发者托管账户。只有在你主动使用 WebDAV、局域网同步或密码泄露检测时，应用才会发起对应的网络请求。",
              quote: "本地保存是默认方式，联网能力由你主动选择。",
              whitepaperLink: "查看安全白皮书",
              productKicker: "产品展示",
              productTitle: "浏览保险库的主要页面。",
              productBody: "从保险库主页到同步与设置，快速了解 Android 客户端的主要页面结构。",
              guideKicker: "功能展示",
              guideTitle: "保险库具备的实用功能。",
              guideBody: "以下能力均可在 Android 工程的加密、自动填充、凭据、扫描与同步模块中找到对应实现。",
              guides: "查看使用指南",
              download: "下载最新版本",
              supportKicker: "赞助支持项目",
              supportTitle: "如果保险库对你有帮助，可以赞助支持项目以持续维护。",
              supportPoints: ["由独立开发者维护", "持续的功能更新与优化", "问题修复与版本维护"],
              supportButton: "了解赞助方式",
          }
        : {
              eyebrow: "",
              title: "Your passwords should truly be yours.",
              intro: "FAEVault manages logins, cards, IDs, Wi-Fi details, and API keys on Android, storing them in a locally encrypted .pmv file.",
              storyLink: "Learn the story",

              storyKicker: "How data is stored",
              storyTitle: "Local-first · Encrypted at rest",
              storyBody:
                  "FAEVault stores its vault in an encrypted file on the device by default and does not provide a developer-hosted account. Network access occurs only when you use features such as WebDAV, LAN sync, or breach checking.",
              quote: "Local storage is the default; network features are your choice.",
              whitepaperLink: "Read the security whitepaper",
              productKicker: "Product showcase",
              productTitle: "Explore the main product screens.",
              productBody: "A quick tour of the Android app, from the vault home screen to sync and settings.",
              guideKicker: "Feature showcase",
              guideTitle: "Practical features for everyday use.",
              guideBody: "Each capability below maps to an implemented Android encryption, autofill, credential, scanning, or sync module.",
              guides: "Browse the guides",
              download: "Download the latest version",
              supportKicker: "Support the project",
              supportTitle: "If FAEVault is useful to you, consider sponsoring to keep it maintained.",
              supportPoints: ["Maintained by a solo developer", "Regular feature updates", "Bug fixes and release maintenance"],
              supportButton: "See sponsorship options",
          };

const features =
    locale === "zh-cn"
        ? [
              { title: "本地加密保险库", body: "scrypt + AES-256-GCM 加密，密码与通行密钥离线存储在本地文件中，数据完全由你掌控。", accent: "vault" },
              { title: "系统自动填充", body: "通过 Android Autofill 服务为登录条目提供填充与保存，并按应用包名或 HTTPS 主机匹配来源。", accent: "flow" },
              { title: "通行密钥", body: "在 Android 14 及以上注册 Credential Provider，处理 Passkey 的创建与凭据查询；可用性取决于系统选择和调用方兼容性。", accent: "passkey" },
              { title: "OCR 智能识别", body: "扫描或导入银行卡、身份证图像，使用端上 OCR 与字段解析器提取卡号、有效期、姓名等信息。", accent: "ocr" },
              { title: "安全防护", body: "使用 FLAG_SECURE、敏感剪贴板标记与定时清理、解锁失败冷却，并为部分敏感操作增加主密码验证。", accent: "security" },
              { title: "同步与备份", body: "支持 WebDAV、与同一局域网内电脑端同步，以及 .pmbak、.pmv 和 CSV 的导入导出。", accent: "sync" },
          ]
        : [
              {
                  title: "Encrypted Vault",
                  body: "scrypt + AES-256-GCM encryption. Passwords and passkeys stay in a local file, fully under your control.",
                  accent: "vault",
              },
              {
                  title: "System Autofill",
                  body: "Android Autofill support for login entries, matched by app package or verified HTTPS host.",
                  accent: "flow",
              },
              {
                  title: "Passkeys",
                  body: "A Credential Provider on Android 14+ for passkey creation and credential queries, subject to system selection and caller compatibility.",
                  accent: "passkey",
              },
              {
                  title: "OCR Scanning",
                  body: "Scan or import card and ID images, then extract supported fields with on-device OCR and parsers.",
                  accent: "ocr",
              },
              {
                  title: "Security Guard",
                  body: "FLAG_SECURE, sensitive clipboard handling, unlock cooldowns, and master-password gates for selected sensitive actions.",
                  accent: "security",
              },
              {
                  title: "Sync & Backup",
                  body: "WebDAV, LAN sync with the desktop app, plus .pmbak, .pmv, and CSV import or export.",
                  accent: "sync",
              },
          ];

const productScreens =
    locale === "zh-cn"
        ? [
              { title: "主页", body: "搜索、分类查看并快速新增本地条目。", pages: [{ image: productImage("home.jpg"), label: "保险库主页" }] },
              { title: "回收站", body: "查看已删除条目，并选择恢复或彻底删除。", pages: [{ image: productImage("trash.jpg"), label: "回收站" }] },
              { title: "数据库维护", body: "对比重复条目、处理相同服务，并管理回收站自动清理。", pages: [{ image: productImage("maintenance.jpg"), label: "保险库维护" }] },
              { title: "密码安全检查", body: "查看密码健康状态、高风险项目与改进建议，并按需执行泄露检查。", pages: [{ image: productImage("password-security.jpg"), label: "密码安全" }] },
              {
                  title: "数据导出和同步",
                  body: "展示本地备份与导出、局域网跨端同步，以及云端文件与 WebDAV 同步。",
                  pages: [
                      { image: productImage("local-export.jpg"), label: "本地数据导出" },
                      { image: productImage("lan-sync.jpg"), label: "局域网跨端同步" },
                      { image: productImage("cloud-sync.jpg"), label: "云端同步" },
                  ],
              },
              { title: "详情页展示", body: "集中查看条目资料，并执行复制、编辑和移入回收站等操作。", pages: [{ image: productImage("entry-detail.jpg"), label: "条目详情" }] },
              { title: "编辑页展示", body: "编辑基础字段，并按需组合图片、附件及其他内容模块。", pages: [{ image: productImage("entry-edit.jpg"), label: "条目编辑" }] },
              {
                  title: "自定义模块展示",
                  body: "分别展示自定义条目的局部内容与完整模块组合。",
                  pages: [
                      { image: productImage("modules-partial.jpg"), label: "模块局部" },
                      { image: productImage("modules-all.jpg"), label: "全部模块" },
                  ],
              },
          ]
        : [
              { title: "Home", body: "Search, browse categories, and quickly add local entries.", pages: [{ image: productImage("home.jpg"), label: "Vault home" }] },
              { title: "Trash", body: "Review deleted entries, restore them, or remove them permanently.", pages: [{ image: productImage("trash.jpg"), label: "Trash" }] },
              { title: "Database maintenance", body: "Compare duplicates, handle entries for the same service, and manage automatic Trash cleanup.", pages: [{ image: productImage("maintenance.jpg"), label: "Vault maintenance" }] },
              { title: "Password security check", body: "Review password health, risks, and improvements, with optional breach checks.", pages: [{ image: productImage("password-security.jpg"), label: "Password security" }] },
              {
                  title: "Data export and sync",
                  body: "Local backup and export, cross-device LAN sync, plus cloud file and WebDAV sync.",
                  pages: [
                      { image: productImage("local-export.jpg"), label: "Local data export" },
                      { image: productImage("lan-sync.jpg"), label: "Cross-device LAN sync" },
                      { image: productImage("cloud-sync.jpg"), label: "Cloud sync" },
                  ],
              },
              { title: "Detail page", body: "Review entry data and access copy, edit, or move-to-Trash actions.", pages: [{ image: productImage("entry-detail.jpg"), label: "Entry details" }] },
              { title: "Edit page", body: "Edit core fields and combine image, attachment, and other content modules.", pages: [{ image: productImage("entry-edit.jpg"), label: "Entry editor" }] },
              {
                  title: "Custom modules",
                  body: "A focused module view alongside the complete custom module composition.",
                  pages: [
                      { image: productImage("modules-partial.jpg"), label: "Module detail" },
                      { image: productImage("modules-all.jpg"), label: "All modules" },
                  ],
              },
          ];
---

<div class="home">
    <section class="section hero" id="opening">
        <div class="hero-inner">
            <div class="hero-copy">
                <h1>{copy.title}</h1>
                <p class="intro">{copy.intro}</p>
                <div class="actions">
                    <a class="primary" href={localePath(locale, "download")}>{copy.download}</a>
                    <a class="secondary" href={localePath(locale, "guides")}>{copy.guides}</a>
                    <a class="text-link" href={localePath(locale, "journey")}>{copy.storyLink}</a>
                </div>
            </div>
        </div>
    </section>

    <section class="showcase-section" id="showcase">
        <div class="showcase-inner">
            <div class="showcase-heading">
                <p class="eyebrow">{copy.productKicker}</p>
                <h2>{copy.productTitle}</h2>
                <p>{copy.productBody}</p>
            </div>
            <div class="carousel-shell">
                <button class="carousel-button previous" type="button" aria-label={locale === "zh-cn" ? "上一项" : "Previous item"}>
                    <span aria-hidden="true">←</span>
                </button>
                <div class="card-carousel" aria-roledescription="carousel" aria-label={locale === "zh-cn" ? "产品页面轮播" : "Product screen carousel"}>
                    <div class="card-track">
                    {
                        productScreens.map((item, i) => (
                            <article class="content-card" aria-label={`${i + 1} / ${productScreens.length}: ${item.title}`}>
                                <div class="cc-media">
                                    <button
                                        class="cc-image-button"
                                        type="button"
                                        data-open-product-image
                                        data-open-label={locale === "zh-cn" ? "查看大图：" : "View full image: "}
                                        aria-label={`${locale === "zh-cn" ? "查看大图：" : "View full image: "}${item.pages[0].label}`}
                                    >
                                        {item.pages.map((screen, screenIndex) => (
                                            <img
                                                class="cc-page-image"
                                                src={screen.image}
                                                alt={screen.label}
                                                loading="lazy"
                                                data-screen-image={screenIndex}
                                                hidden={screenIndex !== 0}
                                            />
                                        ))}
                                    </button>
                                    {item.pages.length > 1 && (
                                        <div class="cc-screen-tabs" role="group" aria-label={locale === "zh-cn" ? "切换页面截图" : "Choose screen image"}>
                                            {item.pages.map((screen, screenIndex) => (
                                                <button
                                                    type="button"
                                                    data-screen-select={screenIndex}
                                                    aria-pressed={screenIndex === 0 ? "true" : "false"}
                                                >
                                                    {screen.label}
                                                </button>
                                            ))}
                                        </div>
                                    )}
                                </div>
                                <div class="cc-meta">
                                    <span class="cc-num">0{i + 1}</span>
                                    <span class="cc-copy"><strong>{item.title}</strong><small>{item.body}</small></span>
                                </div>
                            </article>
                        ))
                    }
                    </div>
                </div>
                <button class="carousel-button next" type="button" aria-label={locale === "zh-cn" ? "下一项" : "Next item"}>
                    <span aria-hidden="true">→</span>
                </button>
            </div>
            <div class="carousel-footer">
                <div class="carousel-dots" role="group" aria-label={locale === "zh-cn" ? "选择轮播项目" : "Choose carousel item"}>
                    {productScreens.map((item, i) => (
                        <button type="button" aria-label={`${locale === "zh-cn" ? "显示" : "Show"} ${item.title}`} data-slide={i}></button>
                    ))}
                </div>
                <p class="carousel-status" aria-live="polite"><span>01</span> / 0{productScreens.length}</p>
            </div>
            <dialog class="product-image-dialog" aria-label={locale === "zh-cn" ? "产品截图大图" : "Full product screenshot"}>
                <button class="product-image-dialog-close" type="button" aria-label={locale === "zh-cn" ? "关闭大图" : "Close full image"}>×</button>
                <img alt="" />
            </dialog>
        </div>
    </section>

    <section class="section guide-section" id="guides">
        <div class="guide-inner">
            <div class="guide-head section-copy">
                <p class="eyebrow">{copy.guideKicker}</p>
                <h2>{copy.guideTitle}</h2>
                <p>{copy.guideBody}</p>
            </div>
            <div class="workflow-side">
                <div class="workflow-stack">
                    {
                        features.map((item) => (
                            <article
                                class="workflow-card"
                                data-feature
                                role="button"
                                tabindex="-1"
                                aria-label={item.title}
                            >
                                <span class={`workflow-dot ${item.accent}`} />
                                <strong>{item.title}</strong>
                                <p>{item.body}</p>
                            </article>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="section split" id="why">
        <div class="split-inner">
            <div class="split-copy section-copy">
                <p class="eyebrow">{copy.storyKicker}</p>
                <h2>{copy.storyTitle}</h2>
                <p class="story-body">{copy.storyBody}</p>
                <blockquote class="slide-quote">{copy.quote}</blockquote>
                <a class="text-link whitepaper-link" href={localePath(locale, "security")}>{copy.whitepaperLink}</a>
            </div>
            <div class="showcase-wrap" aria-label={locale === "zh-cn" ? "保险库 产品展示" : "FAEVault product showcase"}>
                <div class="showcase-shell">
                    <div class="showcase-glow"></div>
                    <div class="showcase-card">
                        <div class="showcase-topbar">
                            <div class="topbar-dots"><span></span><span></span><span></span></div>
                            <div class="topbar-label">{locale === "zh-cn" ? "本地优先 · 加密保存" : "Local-first · Encrypted"}</div>
                        </div>
                        <div class="showcase-grid">
                            <div class="showcase-panel panel-left">
                                <div class="feature-pill">{locale === "zh-cn" ? "可信赖" : "Trustworthy"}</div>
                                <div class="panel-stack">
                                    <div class="panel-row active">
                                        <span class="panel-icon"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? "离线可用" : "Works offline"}</strong>
                                            <em>{locale === "zh-cn" ? "无需网络连接" : "No internet needed"}</em>
                                        </span>
                                    </div>
                                    <div class="panel-row">
                                        <span class="panel-icon muted"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? "本地加密" : "Local encryption"}</strong>
                                            <em>{locale === "zh-cn" ? "数据不出设备" : "Data never leaves"}</em>
                                        </span>
                                    </div>
                                    <div class="panel-row">
                                        <span class="panel-icon accent"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? "无账号体系" : "No accounts"}</strong>
                                            <em>{locale === "zh-cn" ? "打开即用" : "Open and use"}</em>
                                        </span>
                                    </div>
                                    <div class="panel-row active">
                                        <span class="panel-icon"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? "联网按需启用" : "Network is opt-in"}</strong>
                                            <em>{locale === "zh-cn" ? "同步与检测由你发起" : "You start sync or checks"}</em>
                                        </span>
                                    </div>
                                    <div class="panel-row">
                                        <span class="panel-icon muted"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? ".pmv 加密文件" : "Encrypted .pmv file"}</strong>
                                            <em>{locale === "zh-cn" ? "与桌面端格式兼容" : "Desktop-compatible format"}</em>
                                        </span>
                                    </div>
                                    <div class="panel-row">
                                        <span class="panel-icon accent"></span>
                                        <span class="panel-text">
                                            <strong>{locale === "zh-cn" ? "可自行备份" : "Bring your own backup"}</strong>
                                            <em>{locale === "zh-cn" ? "文件级自由备份" : "File-level freedom"}</em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="showcase-panel panel-right">
                                <div class="phone-card">
                                    <div class="phone-screen">
                                        <div class="phone-nav"></div>
                                        <div class="phone-stat">
                                            <span class="stat-chip"></span>
                                            <span class="stat-chip short"></span>
                                        </div>
                                        <div class="phone-list">
                                            <div class="phone-item"></div>
                                            <div class="phone-item short"></div>
                                            <div class="phone-item tiny"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="floating-badge badge-one">{locale === "zh-cn" ? "本地加密" : "Encrypted"}</div>
                                <div class="floating-badge badge-two">{locale === "zh-cn" ? "按需联网" : "Opt-in network"}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section support-section" id="support">
        <div class="support-card">
            <div class="support-card-inner">
                <p class="eyebrow">{copy.supportKicker}</p>
                <h2>{copy.supportTitle}</h2>
                <div class="support-pillars">
                    {
                        copy.supportPoints.map((pt) => (
                            <div class="pillar-card">
                                <span class="pillar-icon" />
                                <span>{pt}</span>
                            </div>
                        ))
                    }
                </div>
                <a class="support-cta" href={localePath(locale, "support")}>{copy.supportButton}</a>
            </div>
        </div>
    </section>
</div>

<style>
    .home {
        position: relative;
    }

    .section {
        padding: clamp(3.6rem, 7vw, 6rem) 0;
    }
    .section > * {
        width: calc(100% - 4rem);
        max-width: 1700px;
        margin: 0 auto;
    }
    .hero {
        padding-top: clamp(4.4rem, 8vw, 7rem);
        padding-bottom: clamp(3.2rem, 6vw, 4.8rem);
    }

    .hero-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }
    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 900px;
    }
    .hero-copy .actions {
        justify-content: center;
    }
    .eyebrow {
        margin: 0 0 1rem;
        color: #287795;
        font-size: 0.72rem;
        font-weight: 820;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    h1,
    h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 500;
        letter-spacing: -0.052em;
    }
    h1 {
        margin: 0;
        font-size: clamp(3rem, 4.4vw, 4rem);
        line-height: 1.04;
    }
    h2 {
        margin: 0;
        font-size: clamp(2.2rem, 4.5vw, 4.2rem);
        line-height: 1.06;
    }
    .intro {
        max-width: 520px;
        margin: 1.2rem 0 0;
        color: #4f6974;
        font:
            1rem/1.8 Georgia,
            serif;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        align-items: center;
        margin-top: 1.8rem;
        position: relative;
        z-index: 1;
    }
    .primary,
    .secondary,
    .tertiary,
    .support-button,
    .text-link {
        cursor: pointer;
    }
    .primary,
    .secondary,
    .tertiary,
    .support-button {
        display: inline-flex;
        gap: 0.6rem;
        align-items: center;
        padding: 0.85rem 1.2rem;
        border-radius: 999px;
        background: #173f50;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 750;
        box-shadow: 0 13px 30px rgba(23, 63, 80, 0.17);
        transition:
            transform 0.18s ease,
            box-shadow 0.18s ease,
            background 0.18s ease;
        pointer-events: auto;
        position: relative;
        z-index: 1;
    }
    .primary:hover,
    .secondary:hover,
    .tertiary:hover,
    .support-button:hover {
        transform: translateY(-3px);
        background: #20596f;
        box-shadow: 0 18px 36px rgba(23, 63, 80, 0.24);
    }
    .primary:active,
    .secondary:active,
    .tertiary:active,
    .support-button:active {
        transform: translateY(0);
        box-shadow: 0 8px 18px rgba(23, 63, 80, 0.12);
        transition:
            transform 0.08s ease,
            box-shadow 0.12s ease;
    }
    .primary:focus,
    .secondary:focus,
    .tertiary:focus,
    .support-button:focus,
    .text-link:focus {
        outline: 3px solid rgba(25, 128, 164, 0.16);
        outline-offset: 3px;
        border-radius: 999px;
    }
    .primary.muted {
        background: #315f72;
    }
    .secondary {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(23, 63, 80, 0.16);
        color: #173f50;
        box-shadow: 0 10px 24px rgba(11, 42, 56, 0.08);
    }
    .secondary:hover {
        background: rgba(255, 255, 255, 1);
    }
    .tertiary {
        background: transparent;
        border: 1px solid rgba(23, 63, 80, 0.16);
        color: #173f50;
        box-shadow: none;
    }
    .tertiary:hover {
        background: rgba(23, 63, 80, 0.05);
        box-shadow: none;
    }
    .text-link {
        position: relative;
        display: inline-flex;
        gap: 0.6rem;
        align-items: center;
        padding-bottom: 0.2rem;
        color: #245e75;
        font-size: 0.83rem;
        font-weight: 760;
        transition:
            gap 0.25s ease,
            color 0.25s ease;
    }
