        background: linear-gradient(135deg, #9bd7ba, #4a8b6c);
        box-shadow: 0 0 0 4px rgba(74, 139, 108, 0.16);
    }
    .workflow-dot.sync {
        background: linear-gradient(135deg, #c6b3f4, #7b5fb1);
        box-shadow: 0 0 0 4px rgba(123, 95, 177, 0.16);
