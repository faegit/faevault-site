        padding: 1.15rem 1.2rem;
        border-radius: 1.45rem;
        border: 1px solid rgba(71, 106, 122, 0.14);
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(241, 248, 251, 0.7));
        box-shadow: 0 20px 40px rgba(41, 81, 95, 0.1);
