</style>

<script>
    (function () {
        const MAX = 6;
        function initTilt() {
            const card = document.querySelector<HTMLElement>(".support-card");
            if (!card || card.dataset.tiltReady === "true") return;
            card.dataset.tiltReady = "true";
            card.addEventListener("mousemove", (e) => {
                const rect = card.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width;
                const y = (e.clientY - rect.top) / rect.height;
                card.style.transform = `perspective(800px) rotateX(${(y - 0.5) * -MAX}deg) rotateY(${(x - 0.5) * MAX}deg)`;
            });
            card.addEventListener("mouseleave", () => {
                card.style.transform = "perspective(800px) rotateX(0) rotateY(0)";
            });
        }

        function initCarousel() {
            const track = document.querySelector<HTMLElement>(".card-track");
            if (!track) return;
            if (track.dataset.carouselReady === "true") return;
            track.dataset.carouselReady = "true";
            const carouselTrack = track;
            const cards = Array.from(track.children) as HTMLElement[];
            if (cards.length < 2) return;
            const shell = track.closest<HTMLElement>(".carousel-shell");
            const viewport = track.parentElement;
            const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".carousel-dots button"));
            const edgeHits = Array.from(viewport?.querySelectorAll<HTMLButtonElement>("[data-carousel-edge]") ?? []);
            const status = document.querySelector<HTMLElement>(".carousel-status span");
            const before = cards[cards.length - 1].cloneNode(true) as HTMLElement;
            const after = cards[0].cloneNode(true) as HTMLElement;
            before.dataset.clone = "true";
            after.dataset.clone = "true";
            before.setAttribute("aria-hidden", "true");
            after.setAttribute("aria-hidden", "true");
            carouselTrack.prepend(before);
            carouselTrack.append(after);
            const displayCards = Array.from(carouselTrack.children) as HTMLElement[];
            const imageDialog = document.querySelector<HTMLDialogElement>(".product-image-dialog");
            const dialogImage = imageDialog?.querySelector<HTMLImageElement>("img");
            const dialogClose = imageDialog?.querySelector<HTMLButtonElement>(".product-image-dialog-close");
            let current = 0;
            let position = 1;
            let moving = false;
            let queuedMove: (() => void) | null = null;
            let hovered = false;
            let dragPointer: number | null = null;
            let dragStartX = 0;
            let dragStartY = 0;
            let suppressClickUntil = 0;
            let autoTimer: ReturnType<typeof setTimeout>;

            function scheduleAuto() {
                clearTimeout(autoTimer);
                if (hovered || imageDialog?.open || document.hidden) return;
                autoTimer = setTimeout(() => {
                    if (moving) {
                        scheduleAuto();
                        return;
                    }
                    moving = true;
                    stepBy(1);
                    scheduleAuto();
                }, 5000);
            }

            function manualMove(move: () => void) {
                clearTimeout(autoTimer);
                if (moving) {
                    queuedMove = move;
                    return;
                }
                moving = true;
                move();
                scheduleAuto();
            }

            function selectScreen(panel: HTMLElement, selectedIndex: number) {
                const images = Array.from(panel.querySelectorAll<HTMLImageElement>("[data-screen-image]"));
                const selectors = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-screen-select]"));
                images.forEach((image, index) => {
                    image.hidden = index !== selectedIndex;
                });
                selectors.forEach((selector, index) => {
                    selector.setAttribute("aria-pressed", String(index === selectedIndex));
                });
                const activeImage = images[selectedIndex];
                const openButton = panel.querySelector<HTMLButtonElement>("[data-open-product-image]");
                if (activeImage && openButton) {
                    openButton.setAttribute("aria-label", `${openButton.dataset.openLabel ?? ""}${activeImage.alt}`);
                }
            }

            carouselTrack.addEventListener("click", (event) => {
                const target = event.target as Element;
                const card = target.closest<HTMLElement>(".content-card");
                if (!card?.classList.contains("active")) return;
                const platformSelector = target.closest<HTMLButtonElement>("[data-platform-select]");
                if (platformSelector) {
                    event.stopPropagation();
                    const platformId = platformSelector.dataset.platformSelect;
                    card.querySelectorAll<HTMLButtonElement>("[data-platform-select]").forEach((button) => {
                        button.setAttribute("aria-pressed", String(button === platformSelector));
                    });
                    card.querySelectorAll<HTMLElement>("[data-platform-panel]").forEach((panel) => {
                        panel.hidden = panel.dataset.platformPanel !== platformId;
                    });
                    const activePanel = card.querySelector<HTMLElement>("[data-platform-panel]:not([hidden])");
                    if (activePanel) selectScreen(activePanel, 0);
                    scheduleAuto();
                    return;
                }
                const selector = target.closest<HTMLButtonElement>("[data-screen-select]");
                if (selector) {
                    event.stopPropagation();
                    const panel = selector.closest<HTMLElement>("[data-platform-panel]");
                    if (panel) selectScreen(panel, Number(selector.dataset.screenSelect ?? 0));
                    scheduleAuto();
                    return;
                }
                const openButton = target.closest<HTMLButtonElement>("[data-open-product-image]");
                if (!openButton) return;
                event.stopPropagation();
                const activeImage = openButton.querySelector<HTMLImageElement>("[data-screen-image]:not([hidden])");
                if (!activeImage || !imageDialog || !dialogImage) return;
                dialogImage.src = activeImage.src;
                dialogImage.alt = activeImage.alt;
                clearTimeout(autoTimer);
                imageDialog.showModal();
            });
            dialogClose?.addEventListener("click", () => {
                imageDialog?.close();
            });
            imageDialog?.addEventListener("click", (event) => {
                if (event.target === imageDialog) {
                    imageDialog.close();
                }
            });
            imageDialog?.addEventListener("close", scheduleAuto);

            function render(animate = true) {
                const gap = parseFloat(getComputedStyle(carouselTrack).gap) || 0;
                const cardWidth = displayCards[0].offsetWidth;
                const step = cardWidth + gap;
                const viewportWidth = viewport?.getBoundingClientRect().width ?? cardWidth;
                const offset = viewportWidth / 2 - (position * step + cardWidth / 2);
                carouselTrack.style.transition = animate ? "transform 520ms cubic-bezier(0.22, 1, 0.36, 1)" : "none";
                carouselTrack.style.transform = `translate3d(${offset}px, 0, 0)`;
                displayCards.forEach((card, index) => {
                    card.classList.toggle("active", index === position);
                });
                cards.forEach((card, index) => {
                    card.setAttribute("aria-hidden", String(index !== current));
                });
                dots.forEach((dot, index) => {
                    dot.classList.toggle("active", index === current);
                    dot.setAttribute("aria-current", index === current ? "true" : "false");
                });
                if (status) status.textContent = String(current + 1).padStart(2, "0");
            }

            function goTo(index: number) {
                current = (index + cards.length) % cards.length;
                position = current + 1;
                render();
            }

            function stepBy(delta: number) {
                current = (current + delta + cards.length) % cards.length;
                position += delta;
                render();
            }

            dots.forEach((dot, index) =>
                dot.addEventListener("click", () => {
                    if (index === current) {
                        scheduleAuto();
                        return;
                    }
                    manualMove(() => goTo(index));
                }),
            );
            edgeHits.forEach((edge) =>
                edge.addEventListener("click", (event) => {
                    event.preventDefault();
                    if (performance.now() < suppressClickUntil) return;
                    manualMove(() => stepBy(Number(edge.dataset.carouselEdge) < 0 ? -1 : 1));
                }),
            );
            displayCards.forEach((card, index) => {
                card.addEventListener("click", () => {
                    const target = index === 0 ? cards.length - 1 : index === displayCards.length - 1 ? 0 : index - 1;
                    if (target !== current) {
                        manualMove(() => {
                            if (index === position - 1) stepBy(-1);
                            else if (index === position + 1) stepBy(1);
                            else goTo(target);
                        });
                    }
                });
            });
            carouselTrack.addEventListener("transitionend", (event) => {
                if (event.target !== carouselTrack) return;
                if (event.propertyName !== "transform") return;
                if (position === 0) {
                    position = cards.length;
                    render(false);
                } else if (position === cards.length + 1) {
                    position = 1;
                    render(false);
                }
                moving = false;
                if (queuedMove) {
                    const move = queuedMove;
                    queuedMove = null;
                    moving = true;
                    move();
                    scheduleAuto();
                }
            });
            viewport?.addEventListener("pointerdown", (event) => {
                if (event.pointerType === "mouse" && event.button !== 0) return;
                dragPointer = event.pointerId;
                dragStartX = event.clientX;
                dragStartY = event.clientY;
                clearTimeout(autoTimer);
            });
            viewport?.addEventListener("pointermove", (event) => {
                if (event.pointerId !== dragPointer) return;
                const dx = event.clientX - dragStartX;
                const dy = event.clientY - dragStartY;
                if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy) && event.cancelable) {
                    event.preventDefault();
                }
            });
            const finishSwipe = (event: PointerEvent) => {
                if (event.pointerId !== dragPointer) return;
                const dx = event.clientX - dragStartX;
                const dy = event.clientY - dragStartY;
                dragPointer = null;
                if (Math.abs(dx) >= 48 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                    suppressClickUntil = performance.now() + 400;
                    manualMove(() => stepBy(dx < 0 ? 1 : -1));
                } else {
                    scheduleAuto();
                }
            };
            viewport?.addEventListener("pointerup", finishSwipe);
            viewport?.addEventListener("pointercancel", (event) => {
                if (event.pointerId !== dragPointer) return;
                dragPointer = null;
                scheduleAuto();
            });
            carouselTrack.addEventListener(
                "click",
                (event) => {
                    if (performance.now() >= suppressClickUntil) return;
                    event.preventDefault();
                    event.stopImmediatePropagation();
                },
                true,
            );
            viewport?.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                event.preventDefault();
                manualMove(() => stepBy(event.key === "ArrowRight" ? 1 : -1));
            });
            shell?.addEventListener("mouseenter", () => {
                hovered = true;
                clearTimeout(autoTimer);
            });
            shell?.addEventListener("mouseleave", () => {
                hovered = false;
                scheduleAuto();
            });
            document.addEventListener("visibilitychange", () => {
                if (document.hidden) clearTimeout(autoTimer);
                else scheduleAuto();
            });
            document.addEventListener("astro:before-swap", () => clearTimeout(autoTimer), { once: true });
            window.addEventListener("resize", () => render(false));
            render(false);
            scheduleAuto();
        }

        document.addEventListener("astro:page-load", () => {
            initTilt();
            initCarousel();
        });
        initTilt();
        initCarousel();
    })();
</script>
