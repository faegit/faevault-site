    .support-section > p {
        color: #5a727c;
        font:
            1rem/1.9 Georgia,
            serif;
    }

    .guide-section {
        justify-content: center;
    }
    .guide-inner {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto !important;
    }
    .guide-head {
