            transparent 70%
        );
        background-size: 300% 100%;
        background-position: 100% 0;
        pointer-events: none;
        animation: shimmer 5s ease-in-out infinite;
    }
    @keyframes shimmer {
        0%,
        60% {
            background-position: 100% 0;
        }
        70% {
            background-position: 0 0;
        }
        100% {
            background-position: 0 0;
        }
    }
    .support-card-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 2.5rem;
    }
    .support-card-inner h2 {
        max-width: 700px;
    }
    .support-pillars {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 0.5rem;
    }
    .pillar-card {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.7rem 1.2rem 0.7rem 1rem;
        border: 1px solid rgba(42, 83, 99, 0.12);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.5);
        color: #2d5567;
        font-size: 0.88rem;
        font-weight: 520;
        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }
    .pillar-card:hover {
        background: rgba(255, 255, 255, 0.8);
        border-color: rgba(42, 83, 99, 0.22);
        transform: translateY(-1px);
    }
    .pillar-icon {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #3f8aa8;
        flex-shrink: 0;
    }
    .support-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding: 0.7rem 1.6rem;
        border: 1px solid rgba(42, 83, 99, 0.15);
        border-radius: 999px;
        color: #2d5567;
        font-size: 0.88rem;
        font-weight: 600;
        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }
    .support-cta:hover {
        background: rgba(255, 255, 255, 0.7);
        border-color: rgba(42, 83, 99, 0.25);
        transform: translateY(-1px);
    }

    @media (max-width: 760px) {
        .feature-grid {
            grid-template-columns: 1fr;
        }
        .hero {
            padding-top: clamp(4.2rem, 14vw, 5.5rem);
        }
        .actions {
            flex-direction: column;
            align-items: stretch;
        }
        .actions a {
            width: 100%;
            justify-content: center;
        }

        .showcase-inner {
            gap: 1rem;
            width: calc(100% - 2.5rem);
        }
        .carousel-shell {
            position: relative;
            display: block;
        }
        .card-carousel {
            width: 100%;
        }
        .content-card {
            flex: 0 0 86%;
        }
        .carousel-button {
            position: absolute;
            top: 46%;
            z-index: 5;
            width: 2.5rem;
            height: 2.5rem;
            transform: translateY(-50%);
        }
        .carousel-button.previous {
            left: -0.75rem;
        }
        .carousel-button.next {
            right: -0.75rem;
        }
        .carousel-button:hover {
            transform: translateY(calc(-50% - 2px));
        }
        .cc-media {
            min-height: 530px;
            padding: 0.75rem 0.75rem 0.6rem;
        }
        .cc-image-button {
            min-height: 470px;
        }
        .cc-page-image {
            height: 470px;
            border-radius: 0.75rem;
        }
        .cc-screen-tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            justify-content: flex-start;
            padding-bottom: 0.1rem;
        }
        .cc-screen-tabs button {
            flex: 0 0 auto;
            font-size: 0.64rem;
        }
        .cc-meta {
            padding: 0.6rem 0.8rem 0.8rem;
        }
        .cc-copy strong {
            font-size: 0.75rem;
        }
        .cc-copy small {
            font-size: 0.65rem;
        }
        .guide-inner {
            gap: 2rem;
        }
        .guide-head {
            max-width: 640px;
            text-align: center;
        }

        .section > * {
            width: calc(100% - 2.5rem);
        }
        .split-copy h2 {
            font-size: clamp(1.6rem, 8vw, 2.8rem);
        }
        .support-card {
            border-radius: 1.7rem;
            width: calc(100% - 2.5rem) !important;
            padding: 2rem 1.1rem;
        }
        .support-card-inner {
            gap: 1.25rem;
        }
        .support-card-inner h2 {
            font-size: clamp(1.8rem, 9vw, 2.4rem);
            line-height: 1.08;
        }
        .support-pillars {
            gap: 0.55rem;
            margin-top: 0;
        }
        .pillar-card {
            padding: 0.5rem 0.8rem;
            font-size: 0.76rem;
        }
        .support-cta {
            margin-top: 0;
        }
    }
</style>

<script>
    (function () {
        const MAX = 6;
        function initTilt() {
            const card = document.querySelector<HTMLElement>(".support-card");
            if (!card) return;
            card.addEventListener("mousemove", (e) => {
                const rect = card.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width;
                const y = (e.clientY - rect.top) / rect.height;
                card.style.transform = `perspective(800px) rotateX(${(y - 0.5) * -MAX}deg) rotateY(${(x - 0.5) * MAX}deg)`;
            });
            card.addEventListener("mouseleave", () => {
                card.style.transform = "perspective(800px) rotateX(0) rotateY(0)";
            });
        }
        document.addEventListener("astro:page-load", initTilt);
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initTilt);
        else initTilt();

        let timer: ReturnType<typeof setInterval>;

        function initStack() {
            const stack = document.querySelector<HTMLElement>(".workflow-stack");
            if (!stack) return;
            if (stack.dataset.stackReady === "true") return;
            const CARDS = Array.from(stack.children) as HTMLElement[];
            const COUNT = CARDS.length;
            if (COUNT < 2) return;
            stack.dataset.stackReady = "true";

            function equalizeHeights() {
                let maxH = 0;
                CARDS.forEach((c) => {
                    c.style.height = "auto";
                    maxH = Math.max(maxH, c.offsetHeight);
                });
                if (maxH > 0)
                    CARDS.forEach((c) => {
                        c.style.height = `${maxH}px`;
                    });
            }

            function applyOffsets(activeIndex: number) {
                CARDS.forEach((card, i) => {
                    const offset = (i - activeIndex + COUNT) % COUNT;
                    const y = offset * 18;
                    const scale = 1 - offset * 0.035;
                    card.style.transition = "transform 420ms ease, opacity 420ms ease";
                    card.style.transform = `translateY(${y}px) scale(${scale})`;
                    card.style.zIndex = `${COUNT - offset}`;
                    card.style.opacity = String(1 - offset * 0.06);
                    card.classList.toggle("active", offset === 0);
                    card.setAttribute("aria-hidden", String(offset !== 0));
                    card.tabIndex = offset === 0 ? 0 : -1;
                });
            }

            let current = 0;
            let running = false;
            equalizeHeights();
            applyOffsets(0);

            function advance(restoreFocus = false) {
                if (running) return;
                running = true;
                const oldCard = CARDS[current];
                oldCard.classList.add("fade-up");
                setTimeout(() => {
                    current = (current + 1) % COUNT;
                    oldCard.classList.remove("fade-up");
                    applyOffsets(current);
                    if (restoreFocus) CARDS[current].focus();
                    running = false;
                }, 440);
            }

            CARDS.forEach((card) => {
                card.addEventListener("click", () => {
                    if (card.classList.contains("active")) advance();
                });
                card.addEventListener("keydown", (event) => {
                    if (!card.classList.contains("active")) return;
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        advance(true);
                    }
                });
            });

            const DELAY = 4500;
            clearInterval(timer);
            timer = setInterval(advance, DELAY);

            stack.addEventListener("mouseenter", () => {
                clearInterval(timer);
            });
            stack.addEventListener("mouseleave", () => {
                clearInterval(timer);
                timer = setInterval(advance, DELAY);
            });
        }

        document.addEventListener("astro:page-load", initStack);
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initStack);
        else initStack();

        /* ── Product Carousel ── */
        function initCarousel() {
            const track = document.querySelector<HTMLElement>(".card-track");
            if (!track) return;
            if (track.dataset.carouselReady === "true") return;
            track.dataset.carouselReady = "true";
            const carouselTrack = track;
            const cards = Array.from(track.children) as HTMLElement[];
            if (cards.length < 2) return;
            const shell = track.closest<HTMLElement>(".carousel-shell");
            const viewport = track.parentElement;
            const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".carousel-dots button"));
            const status = document.querySelector<HTMLElement>(".carousel-status span");
            const previous = shell?.querySelector<HTMLButtonElement>(".previous");
            const next = shell?.querySelector<HTMLButtonElement>(".next");
            const before = cards[cards.length - 1].cloneNode(true) as HTMLElement;
            const after = cards[0].cloneNode(true) as HTMLElement;
            before.dataset.clone = "true";
            after.dataset.clone = "true";
            before.setAttribute("aria-hidden", "true");
            after.setAttribute("aria-hidden", "true");
            carouselTrack.prepend(before);
            carouselTrack.append(after);
            const displayCards = Array.from(carouselTrack.children) as HTMLElement[];
            const imageDialog = document.querySelector<HTMLDialogElement>(".product-image-dialog");
            const dialogImage = imageDialog?.querySelector<HTMLImageElement>("img");
            const dialogClose = imageDialog?.querySelector<HTMLButtonElement>(".product-image-dialog-close");
            let current = 0;
            let position = 1;

            function selectScreen(card: HTMLElement, selectedIndex: number) {
                const images = Array.from(card.querySelectorAll<HTMLImageElement>("[data-screen-image]"));
                const selectors = Array.from(card.querySelectorAll<HTMLButtonElement>("[data-screen-select]"));
                images.forEach((image, index) => {
                    image.hidden = index !== selectedIndex;
                });
                selectors.forEach((selector, index) => {
                    selector.setAttribute("aria-pressed", String(index === selectedIndex));
                });
                const activeImage = images[selectedIndex];
                const openButton = card.querySelector<HTMLButtonElement>("[data-open-product-image]");
                if (activeImage && openButton) {
                    openButton.setAttribute("aria-label", `${openButton.dataset.openLabel ?? ""}${activeImage.alt}`);
                }
            }

            displayCards.forEach((card) => {
                card.querySelectorAll<HTMLButtonElement>("[data-screen-select]").forEach((selector) => {
                    selector.addEventListener("click", (event) => {
                        if (!card.classList.contains("active")) return;
                        event.stopPropagation();
                        selectScreen(card, Number(selector.dataset.screenSelect ?? 0));
                    });
                });
                card.querySelector<HTMLButtonElement>("[data-open-product-image]")?.addEventListener("click", (event) => {
                    if (!card.classList.contains("active")) return;
                    event.stopPropagation();
                    const activeImage = card.querySelector<HTMLImageElement>("[data-screen-image]:not([hidden])");
                    if (!activeImage || !imageDialog || !dialogImage) return;
                    dialogImage.src = activeImage.src;
                    dialogImage.alt = activeImage.alt;
                    imageDialog.showModal();
                });
            });
            dialogClose?.addEventListener("click", () => {
                imageDialog?.close();
            });
            imageDialog?.addEventListener("click", (event) => {
                if (event.target === imageDialog) {
                    imageDialog.close();
                }
            });

            function render(animate = true) {
                const gap = parseFloat(getComputedStyle(carouselTrack).gap) || 0;
                const cardWidth = displayCards[0].offsetWidth;
                const step = cardWidth + gap;
                const viewportWidth = viewport?.getBoundingClientRect().width ?? cardWidth;
                const offset = viewportWidth / 2 - (position * step + cardWidth / 2);
                carouselTrack.style.transition = animate
                    ? "transform 520ms cubic-bezier(0.22, 1, 0.36, 1)"
                    : "none";
                carouselTrack.style.transform = `translate3d(${offset}px, 0, 0)`;
                displayCards.forEach((card, index) => {
                    card.classList.toggle("active", index === position);
                });
                cards.forEach((card, index) => {
                    card.setAttribute("aria-hidden", String(index !== current));
                });
                dots.forEach((dot, index) => {
                    dot.classList.toggle("active", index === current);
                    dot.setAttribute("aria-current", index === current ? "true" : "false");
                });
                if (status) status.textContent = String(current + 1).padStart(2, "0");
            }

            function goTo(index: number) {
                current = (index + cards.length) % cards.length;
                position = current + 1;
                render();
            }

            function stepBy(delta: number) {
                current = (current + delta + cards.length) % cards.length;
                position += delta;
                render();
            }

            previous?.addEventListener("click", () => stepBy(-1));
            next?.addEventListener("click", () => stepBy(1));
            dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index)));
            displayCards.forEach((card, index) => {
                card.addEventListener("click", () => {
                    const target = index === 0 ? cards.length - 1 : index === displayCards.length - 1 ? 0 : index - 1;
                    if (target !== current) {
                        if (index === position - 1) stepBy(-1);
                        else if (index === position + 1) stepBy(1);
                        else goTo(target);
                    }
                });
            });
            carouselTrack.addEventListener("transitionend", (event) => {
                if (event.propertyName !== "transform") return;
                if (position === 0) {
                    position = cards.length;
                    render(false);
                } else if (position === cards.length + 1) {
                    position = 1;
                    render(false);
                }
            });
            window.addEventListener("resize", () => render(false));
            render(false);
        }

        document.addEventListener("astro:page-load", initCarousel);
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initCarousel);
        else initCarousel();
    })();
</script>
