        justify-content: center;
        padding-bottom: clamp(4rem, 8vw, 7rem) !important;
    }
    .support-card {
        position: relative;
        overflow: hidden;
        width: min(900px, calc(100% - 3rem)) !important;
        margin: 0 auto !important;
        padding: clamp(3.5rem, 7vw, 6rem);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 2.5rem;
        background: linear-gradient(135deg, rgba(229, 248, 247, 0.62), rgba(229, 237, 251, 0.48));
