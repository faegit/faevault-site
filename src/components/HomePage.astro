    .topbar-label {
        color: #4e6973;
        font-size: 0.7rem;
        font-weight: 760;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .showcase-grid {
        display: grid;
        grid-template-columns: 1.02fr 0.98fr;
        gap: 0.9rem;
    }
    .showcase-panel {
        position: relative;
        border-radius: 1.15rem;
        padding: 1rem;
        min-height: 240px;
    }
    .panel-left {
        background: linear-gradient(145deg, rgba(14, 73, 95, 0.96), rgba(31, 115, 140, 0.92));
        color: #f4fbff;
    }
    .panel-right {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(239, 247, 250, 0.95));
        border: 1px solid rgba(82, 126, 141, 0.12);
    }
    .feature-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.42rem 0.64rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
        color: #f7fdff;
        font-size: 0.7rem;
        font-weight: 760;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }
    .panel-stack {
        display: grid;
        gap: 0.6rem;
        margin-top: 0.95rem;
    }
    .panel-row {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.7rem 0.75rem;
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.13);
    }
    .panel-row.active {
        background: rgba(255, 255, 255, 0.16);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    }
    .panel-icon {
        width: 0.85rem;
        height: 0.85rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #7dd2e6, #2d7c95);
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.16);
    }
    .panel-icon.muted {
        background: linear-gradient(135deg, #b9d4de, #7a95a1);
    }
    .panel-icon.accent {
        background: linear-gradient(135deg, #c4adff, #7a5db5);
    }
    .panel-text {
        display: flex;
        flex-direction: column;
        gap: 0.08rem;
    }
    .panel-text strong {
        font-size: 0.8rem;
        font-weight: 760;
    }
    .panel-text em {
        color: rgba(247, 253, 255, 0.74);
        font-size: 0.68rem;
        font-style: normal;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .phone-card {
        position: relative;
        width: min(220px, 100%);
        margin: 1rem auto 0;
        padding: 0.8rem;
        border-radius: 1.45rem;
        background: linear-gradient(135deg, #153f50 0%, #2f6c82 55%, #4f9bb0 100%);
        box-shadow: 0 18px 38px rgba(24, 61, 74, 0.22);
    }
    .phone-screen {
        border-radius: 1.1rem;
        padding: 0.85rem;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(223, 240, 245, 0.9));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }
    .phone-nav {
        width: 42%;
        height: 0.4rem;
        border-radius: 999px;
        background: rgba(62, 95, 107, 0.2);
        margin-bottom: 0.8rem;
    }
    .phone-stat {
        display: flex;
        gap: 0.45rem;
        margin-bottom: 0.7rem;
    }
    .stat-chip {
        width: 70px;
        height: 0.6rem;
        border-radius: 999px;
        background: linear-gradient(90deg, #3f8197, #62b6d1);
    }
    .stat-chip.short {
        width: 44px;
    }
    .phone-list {
        display: grid;
        gap: 0.45rem;
    }
    .phone-item {
        height: 0.72rem;
        border-radius: 999px;
        background: linear-gradient(90deg, rgba(44, 91, 112, 0.34), rgba(44, 91, 112, 0.12));
    }
    .phone-item.short {
        width: 72%;
    }
    .phone-item.tiny {
        width: 48%;
    }
    .floating-badge {
        position: absolute;
        padding: 0.4rem 0.56rem;
        border-radius: 999px;
        border: 1px solid rgba(70, 111, 128, 0.16);
        background: rgba(255, 255, 255, 0.9);
        color: #2f5564;
        font-size: 0.68rem;
        font-weight: 760;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        box-shadow: 0 10px 24px rgba(37, 82, 95, 0.12);
    }
    .badge-one {
        top: 0.5rem;
        right: 0.55rem;
    }
    .badge-two {
        bottom: 0.6rem;
        left: 0.45rem;
    }

    @media (max-width: 760px) {
        .showcase-wrap {
            max-width: 100%;
        }
        .hero-inner {
            gap: 1.25rem;
            align-items: start;
        }
        .showcase-grid {
            grid-template-columns: 1fr;
        }
        .showcase-panel {
            min-height: auto;
        }
        .panel-right {
            min-height: 230px;
        }
        .phone-card {
            margin-top: 0.7rem;
        }
        .floating-badge {
            position: static;
            display: inline-flex;
            margin-top: 0.55rem;
            margin-right: 0.45rem;
        }
        .panel-right {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }
