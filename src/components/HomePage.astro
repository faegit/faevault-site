---
import type { Locale } from "../i18n/config";
import { localePath } from "../i18n/config";
import { withBaseAsset } from "../config/site";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const productImage = (name: string) => `${import.meta.env.BASE_URL}images/product/${name}`;
const appIcon = withBaseAsset("/favicon.ico");
const zh = locale === "zh-cn";

const copy = zh
    ? {
          heroBadge: "为真正重要的凭据而设计",
          titleLine: "你的密码和数据，",
          titleAccent: "完全由你掌控。",
          intro: "保险库在 Android 设备上管理登录、银行卡、身份证、Wi-Fi 与 API 密钥，并将数据保存到本地加密的 .pmv 文件。",
          primaryCta: "免费开始使用",
          secondaryCta: "浏览全部功能",
          storyLink: "了解产品故事 →",
          proofs: ["本地优先 · 离线可用", "无账号体系 · 打开即用", "多端一致 · 局域网同步"],
          windowTitle: "保险库",
          floatingCardTitle: ".pmv 加密文件",
          floatingCardSub: "数据离开设备前保持加密状态",
          floatingCardAction: "查看安全设计 →",

          trustKicker: "",
          trustItems: [
              { value: "AES-256-GCM", label: "本地数据加密" },
              { value: "Passkey", label: "无密码登录体验" },
              { value: "Autofill", label: "系统级自动填充" },
              { value: "WebDAV·LAN", label: "跨设备同步能力" },
          ],

          featuresKicker: "功能亮点",
          featuresTitle: "把安全能力放在需要的位置",
          featuresCopy: "不堆叠复杂入口，不强迫改变使用习惯。加密、自动填充、Passkey、OCR 与同步，都围绕同一个保险库逻辑组织。",

          securityKicker: "安全架构",
          securityTitle: "安全应该可理解，也应该可验证",
          securityCopy: "设计重点不是制造神秘感，而是让数据如何保存、如何解锁、如何同步都保持清晰边界。",
          securityList: [
              { title: "端侧加密", body: "scrypt + AES-256-GCM，敏感数据在离开设备前保持加密状态。" },
              { title: "敏感信息防护", body: "FLAG_SECURE、敏感剪贴板定时清理与解锁失败冷却。" },
              { title: "同步边界可控", body: "WebDAV、局域网同步由你主动发起，不改变保险库的加密边界。" },
          ],
          whitepaperLink: "查看安全白皮书 →",
          orbitChips: ["本地数据库", "Passkey", "设备验证", "加密同步"],

          productKicker: "产品展示",
          productTitle: "浏览保险库的主要页面。",
          productBody: "从保险库主页到同步与设置，对照查看 PC 与 Android 客户端的主要页面结构。",

          ctaTitle: "把密码管理，重新变得简单",
          ctaCopy: "一个更克制、更透明、更适合长期使用的本地密码管理器。最新版本与更新说明都可以在下载页获取。",
          ctaPrimary: "下载 Android 版",
          ctaSecondary: "查看更新日志",

          supportKicker: "赞助支持项目",
          supportTitle: "如果保险库对你有帮助，可以赞助支持项目以持续维护。",
          supportPoints: ["由独立开发者维护", "持续的功能更新与优化", "问题修复与版本维护"],
          supportButton: "了解赞助方式",
      }
    : {
          heroBadge: "Designed for credentials that matter",
          titleLine: "Your passwords and data,",
          titleAccent: "entirely under your control.",
          intro: "On Android, FAEVault manages logins, bank cards, IDs, Wi-Fi details, and API keys, storing everything in a locally encrypted .pmv file.",
          primaryCta: "Get started free",
          secondaryCta: "Browse all features",
          storyLink: "Discover the product story →",
          proofs: ["Local-first · works offline", "No accounts · open and use", "Consistent across devices"],
          windowTitle: "FAE Vault",
          floatingCardTitle: "Encrypted .pmv file",
          floatingCardSub: "Data stays encrypted before it ever leaves the device",
          floatingCardAction: "View security design →",

          trustKicker: "",
          trustItems: [
              { value: "AES-256-GCM", label: "Local data encryption" },
              { value: "Passkey", label: "Passwordless sign-in" },
              { value: "Autofill", label: "System-level filling" },
              { value: "WebDAV·LAN", label: "Cross-device sync" },
          ],

          featuresKicker: "Highlights",
          featuresTitle: "Security where you actually need it",
          featuresCopy: "No stacked menus, no forced habits. Encryption, autofill, passkeys, OCR, and sync are all organized around a single vault logic.",

          securityKicker: "Security architecture",
          securityTitle: "Security should be understandable — and verifiable",
          securityCopy: "The goal is not mystery. How data is stored, unlocked, and synced should all stay within clear boundaries.",
          securityList: [
              { title: "End-side encryption", body: "scrypt + AES-256-GCM keeps sensitive data encrypted before it leaves the device." },
              { title: "Sensitive-data protection", body: "FLAG_SECURE, sensitive clipboard clearing, and unlock-failure cooldowns." },
              { title: "Controllable sync boundary", body: "WebDAV and LAN sync start only when you do — without changing the encryption boundary." },
          ],
          whitepaperLink: "Read the security whitepaper →",
          orbitChips: ["Local database", "Passkey", "Device auth", "Encrypted sync"],

          productKicker: "Product showcase",
          productTitle: "Browse FAEVault's main screens.",
          productBody: "From the vault home page through sync and settings, compare the structure of the main PC and Android screens.",

          ctaTitle: "Make password management simple again",
          ctaCopy: "A calmer, more transparent password manager built for the long run. Releases and changelogs live on the download page.",
          ctaPrimary: "Download for Android",
          ctaSecondary: "View changelog",

          supportKicker: "Support the project",
          supportTitle: "If FAEVault has helped you, you can sponsor the project to support its ongoing maintenance.",
          supportPoints: ["Maintained by an independent developer", "Ongoing feature updates and refinements", "Bug fixes and release maintenance"],
          supportButton: "Learn how to sponsor",
      };

const features = zh
    ? [
          {
              kind: "primary",
              icon: "sync",
              title: "跨设备，同一个保险库",
              body: "支持 WebDAV 与局域网同步，以及 .pmbak、.pmv 和 CSV 导入导出。同步状态清晰可见，设备之间保持一致，而不是让你猜测哪一份数据才是最新。",
              art: "sync",
          },
          {
              kind: "secondary",
              icon: "vault",
              title: "本地加密保险库",
              body: "scrypt + AES-256-GCM 加密，密码与通行密钥离线存储在本地文件中，数据完全由你掌控。",
              art: null,
          },
          {
              kind: "third",
              icon: "fill",
              title: "系统自动填充",
              body: "通过 Android Autofill 服务为登录条目提供填充与保存，并按应用包名或 HTTPS 主机匹配来源。",
              art: "field",
          },
          {
              kind: "third",
              icon: "passkey",
              title: "Passkey 原生体验",
              body: "在 Android 14 及以上注册 Credential Provider，处理 Passkey 的创建与凭据查询。",
              art: null,
          },
          {
              kind: "third",
              icon: "ocr",
              title: "OCR 智能识别",
              body: "扫描或导入银行卡、身份证图像，端上提取卡号、有效期、姓名等信息。",
              art: "otp",
          },
      ]
    : [
          {
              kind: "primary",
              icon: "sync",
              title: "One vault across devices",
              body: "WebDAV and LAN sync, plus import/export for .pmbak, .pmv, and CSV. Sync state stays visible and consistent, so you never guess which copy is current.",
              art: "sync",
          },
          {
              kind: "secondary",
              icon: "vault",
              title: "Locally encrypted vault",
              body: "With scrypt + AES-256-GCM encryption, passwords and passkeys are stored offline in a local file, keeping your data entirely under your control.",
              art: null,
          },
          {
              kind: "third",
              icon: "fill",
              title: "System autofill",
              body: "Android Autofill fills and saves login entries, matching each source by app package name or HTTPS host.",
              art: "field",
          },
          {
              kind: "third",
              icon: "passkey",
              title: "Native passkeys",
              body: "A Credential Provider on Android 14+ handles passkey creation and credential queries.",
              art: null,
          },
          {
              kind: "third",
              icon: "ocr",
              title: "OCR recognition",
              body: "Scan or import bank card and ID images, then extract numbers, expiry dates, and names on-device.",
              art: "otp",
          },
      ];

const productScreensBase = zh
    ? [
          { title: "主页", body: "搜索、分类查看并快速新增本地条目。", pages: [{ image: productImage("home.png"), label: "保险库主页" }] },
          { title: "回收站", body: "查看已删除条目，并选择恢复或彻底删除。", pages: [{ image: productImage("trash.png"), label: "回收站" }] },
          { title: "数据库维护", body: "对比重复条目、处理相同服务，并管理回收站自动清理。", pages: [{ image: productImage("maintenance.png"), label: "保险库维护" }] },
          { title: "密码安全检查", body: "查看密码健康状态、高风险项目与改进建议，并按需执行泄露检查。", pages: [{ image: productImage("password-security.png"), label: "密码安全" }] },
          {
              title: "数据导出和同步",
              body: "展示本地备份与导出、局域网跨端同步，以及云端文件与 WebDAV 同步。",
              pages: [
                  { image: productImage("local-export.png"), label: "本地数据导出" },
                  { image: productImage("lan-sync.png"), label: "局域网跨端同步" },
                  { image: productImage("cloud-sync.png"), label: "云端同步" },
              ],
          },
          { title: "详情页展示", body: "集中查看条目资料，并执行复制、编辑和移入回收站等操作。", pages: [{ image: productImage("entry-detail.png"), label: "条目详情" }] },
          { title: "编辑页展示", body: "编辑基础字段，并按需组合图片、附件及其他内容模块。", pages: [{ image: productImage("entry-edit.png"), label: "条目编辑" }] },
          {
              title: "自定义模块展示",
              body: "分别展示自定义条目的局部内容与完整模块组合。",
              pages: [
                  { image: productImage("modules-partial.png"), label: "模块局部" },
                  { image: productImage("modules-all.png"), label: "全部模块" },
              ],
          },
      ]
    : [
          { title: "Home", body: "Search, browse categories, and quickly add local entries.", pages: [{ image: productImage("home.png"), label: "Vault home" }] },
          { title: "Trash", body: "Review deleted entries, restore them, or remove them permanently.", pages: [{ image: productImage("trash.png"), label: "Trash" }] },
          { title: "Database maintenance", body: "Compare duplicate entries, handle entries for the same service, and manage automatic Trash cleanup.", pages: [{ image: productImage("maintenance.png"), label: "Vault maintenance" }] },
          { title: "Password security check", body: "View password health, high-risk entries, and improvement suggestions, and run breach checks when needed.", pages: [{ image: productImage("password-security.png"), label: "Password security" }] },
          {
              title: "Data export and sync",
              body: "See local backup and export, cross-device LAN sync, and cloud-file and WebDAV sync.",
              pages: [
                  { image: productImage("local-export.png"), label: "Local data export" },
                  { image: productImage("lan-sync.png"), label: "Cross-device LAN sync" },
                  { image: productImage("cloud-sync.png"), label: "Cloud sync" },
              ],
          },
          { title: "Detail page", body: "View entry data in one place, then copy, edit, or move the entry to Trash.", pages: [{ image: productImage("entry-detail.png"), label: "Entry details" }] },
          { title: "Edit page", body: "Edit basic fields and add images, attachments, and other content modules as needed.", pages: [{ image: productImage("entry-edit.png"), label: "Entry editor" }] },
          {
              title: "Custom modules",
              body: "See both a focused view and the complete module composition of a custom entry.",
              pages: [
                  { image: productImage("modules-partial.png"), label: "Module detail" },
                  { image: productImage("modules-all.png"), label: "All modules" },
              ],
          },
      ];

const pcPages = zh
    ? [
          [{ image: productImage("pc-home.png"), label: "PC 主页" }],
          [{ image: productImage("pc-trash.png"), label: "PC 回收站" }],
          [{ image: productImage("pc-maintenance.png"), label: "PC 数据整理" }],
          [{ image: productImage("pc-password-security.png"), label: "PC 密码安全检查" }],
          [{ image: productImage("pc-data-export-sync.png"), label: "PC 数据导出与同步" }],
          [{ image: productImage("pc-entry-detail.png"), label: "PC 条目详情" }],
          [{ image: productImage("pc-entry-edit.png"), label: "PC 条目编辑" }],
          [
              { image: productImage("pc-modules-partial.png"), label: "PC 模块局部" },
              { image: productImage("pc-modules-all.png"), label: "PC 全部模块" },
          ],
      ]
    : [
          [{ image: productImage("pc-home.png"), label: "PC home" }],
          [{ image: productImage("pc-trash.png"), label: "PC Trash" }],
          [{ image: productImage("pc-maintenance.png"), label: "PC data organization" }],
          [{ image: productImage("pc-password-security.png"), label: "PC password security" }],
          [{ image: productImage("pc-data-export-sync.png"), label: "PC data export and sync" }],
          [{ image: productImage("pc-entry-detail.png"), label: "PC entry details" }],
          [{ image: productImage("pc-entry-edit.png"), label: "PC entry editor" }],
          [
              { image: productImage("pc-modules-partial.png"), label: "PC module detail" },
              { image: productImage("pc-modules-all.png"), label: "PC all modules" },
          ],
      ];

const productScreens = productScreensBase.map((item, index) => ({
    ...item,
    platforms: [
        { id: "pc", label: "PC", pages: pcPages[index] },
        { id: "android", label: "Android", pages: item.pages },
    ],
}));
---

<div class="home">
    <section class="hero" id="opening">
        <div class="container hero-grid">
            <div class="hero-copy" data-reveal>
                <div class="hero-badge">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 3l7 3v5c0 4.9-2.7 8.2-7 10-4.3-1.8-7-5.1-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.8"></path>
                        <path d="m9.3 12.2 1.8 1.8 3.8-4.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    {copy.heroBadge}
                </div>

                <h1 class="hero-title">
                    {copy.titleLine}
                    <span class="accent">{copy.titleAccent}</span>
                </h1>

                <p class="hero-intro">{copy.intro}</p>

                <div class="hero-actions">
                    <a class="btn btn-primary btn-large" href={localePath(locale, "download")}>
                        {copy.primaryCta}
                        <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </a>
                    <a class="btn btn-secondary btn-large" href={localePath(locale, "security")}>{copy.secondaryCta}</a>
                </div>

                <a class="story-link" href={localePath(locale, "journey")}>{copy.storyLink}</a>

                <div class="hero-proof">
                    {
                        copy.proofs.map((item) => (
                            <span class="proof-item">
                                <span class="proof-dot">
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                                {item}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="product-stage" data-reveal>
                <div class="glow glow-a"></div>
                <div class="glow glow-b"></div>

                <div class="app-window">
                    <div class="window-bar">
                        <div class="window-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <div class="window-title">
                            <img class="window-app-icon" src={appIcon} alt="" width="14" height="14" />
                            {copy.windowTitle}
                        </div>
                        <div class="window-spacer"></div>
                    </div>
                    <div class="window-body">
                        <img src={productImage("pc-home.png")} alt={zh ? "保险库主页截图" : "Screenshot of the vault home screen"} loading="eager" draggable="false" />
                    </div>
                </div>

                <a class="float-card" href={localePath(locale, "security")}>
                    <div class="float-head">
                        <span class="float-icon">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 3l7 3v5c0 4.9-2.7 8.2-7 10-4.3-1.8-7-5.1-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.8"></path>
                                <rect x="9" y="10" width="6" height="5" rx="1.4" stroke="currentColor" stroke-width="1.7"></rect>
                                <path d="M10.5 10V8.7a1.5 1.5 0 0 1 3 0V10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                            </svg>
                        </span>
                        <span>
                            <strong>{copy.floatingCardTitle}</strong>
                            <em>{copy.floatingCardSub}</em>
                        </span>
                    </div>
                    <span class="float-action">{copy.floatingCardAction}</span>
                </a>
            </div>
        </div>
    </section>

    <section class="trust-strip">
        <div class="container trust-grid">
            {
                copy.trustItems.map((item) => (
                    <div class="trust-item">
                        <div class="trust-value">{item.value}</div>
                        <div class="trust-label">{item.label}</div>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="section" id="features">
        <div class="container">
            <div class="section-head" data-reveal>
                <div class="eyebrow-pill">
                    <span class="eyebrow-dot"></span>
                    {copy.featuresKicker}
                </div>
                <h2 class="section-title">{copy.featuresTitle}</h2>
                <p class="section-copy">{copy.featuresCopy}</p>
            </div>

            <div class="features-grid">
                {
                    features.map((feature) => (
                        <article class:list={["feature-card", feature.kind]} data-reveal>
                            <div class="feature-icon">
                                {feature.icon === "sync" && (
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M7 8a5 5 0 0 1 8.7-3.4L18 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                        <path d="M17 16a5 5 0 0 1-8.7 3.4L6 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                        <path d="M18 3v4h-4M6 21v-4h4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                )}
                                {feature.icon === "vault" && (
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M12 3l7 3v5c0 4.9-2.7 8.2-7 10-4.3-1.8-7-5.1-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.9" />
                                        <rect x="9" y="10" width="6" height="5" rx="1.4" stroke="currentColor" stroke-width="1.9" />
                                        <path d="M10.5 10V8.7a1.5 1.5 0 0 1 3 0V10" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                    </svg>
                                )}
                                {feature.icon === "fill" && (
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 5h14v14H5z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                                        <path d="M8 9h8M8 13h5M8 17h7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                    </svg>
                                )}
                                {feature.icon === "passkey" && (
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle cx="8" cy="12" r="4" stroke="currentColor" stroke-width="1.9" />
                                        <path d="M12 12h9M17 12v3M20 12v2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                                    </svg>
                                )}
                                {feature.icon === "ocr" && (
                                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.9" />
                                        <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                )}
                            </div>

                            <h3 class="feature-title">{feature.title}</h3>
                            <p class="feature-copy">{feature.body}</p>

                            {feature.art === "sync" && (
                                <div class="feature-art sync-art" aria-hidden="true">
                                    <div class="sync-node one">PC</div>
                                    <div class="sync-node two">WEB</div>
                                    <div class="sync-node three">APP</div>
                                    <span class="sync-line a"></span>
                                    <span class="sync-line b"></span>
                                    <span class="sync-line c"></span>
                                </div>
                            )}
                            {feature.art === "field" && (
                                <div class="feature-art field-art" aria-hidden="true">
                                    <div class="field-line"></div>
                                    <div class="field-line"></div>
                                    <div class="field-line"></div>
                                </div>
                            )}
                            {feature.art === "otp" && (
                                <div class="feature-art otp-art" aria-hidden="true">
                                    <span>4</span>
                                    <span>8</span>
                                    <span>2</span>
                                    <span>1</span>
                                </div>
                            )}
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section" id="security">
        <div class="container">
            <div class="security-wrap" data-reveal>
                <div class="security-grid">
                    <div>
                        <div class="eyebrow-pill">
                            <span class="eyebrow-dot"></span>
                            {copy.securityKicker}
                        </div>
                        <h2 class="section-title">{copy.securityTitle}</h2>
                        <p class="section-copy">{copy.securityCopy}</p>

                        <div class="security-list">
                            {
                                copy.securityList.map((item) => (
                                    <div class="security-item">
                                        <div class="security-check">
                                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </div>
                                        <div>
                                            <strong>{item.title}</strong>
                                            <span>{item.body}</span>
