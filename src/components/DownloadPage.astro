---
import type { Locale } from "../i18n/config";
import PageShell from "./PageShell.astro";

/**
 * 版本与下载地址在构建时从 GitHub Releases 读取，避免官网与实际发布版本脱节。
 * 分别选择 Android 和 PC 的正式发布，且 PC 发布必须包含对应的安装包。
 * 网络不可用时回退到 FALLBACK_VERSION，保证本地构建与 Pages 构建都能成功。
 */
const RELEASES_API = "https://api.github.com/repos/faegit/faevault-site/releases?per_page=100";
const ANDROID_TAG_PREFIX = "android/v";
const PC_TAG_PREFIX = "pc/v";
const FALLBACK_VERSION = "4.6.8";
const APK_ASSET = "faevault-arm64-v8a.apk";
const PC_CERT_ASSET = "FAE-Vault-CodeSigning.cer";
const CHECKSUM_ASSET = "SHA256SUMS.txt";

type ReleaseAsset = { name?: string; browser_download_url?: string };
type Release = { tag_name?: string; draft?: boolean; prerelease?: boolean; html_url?: string; assets?: ReleaseAsset[] };

function versionKey(version: string): number {
    const match = /^(\d+)\.(\d+)\.(\d+)/.exec(version);
    if (!match) return 0;
    return Number(match[1]) * 1_000_000 + Number(match[2]) * 1_000 + Number(match[3]);
}

async function latestReleases(): Promise<Release[]> {
    try {
        const response = await fetch(RELEASES_API, {
            headers: { Accept: "application/vnd.github+json", "User-Agent": "FAEVault-site-build" },
        });
        if (!response.ok) return [];
        return (await response.json()) as Release[];
    } catch {
        return [];
    }
}

function latestRelease(releases: Release[], prefix: string, requiredAsset: (version: string) => string): Release | null {
    return releases
        .filter((item) => typeof item?.tag_name === "string"
            && item.tag_name.startsWith(prefix)
            && !item.draft && !item.prerelease
            && item.assets?.some((asset) => asset.name === requiredAsset(item.tag_name!.slice(prefix.length))))
        .sort((a, b) =>
            versionKey(b.tag_name!.slice(prefix.length))
            - versionKey(a.tag_name!.slice(prefix.length)))[0] ?? null;
}

const releases = await latestReleases();
const release = latestRelease(releases, ANDROID_TAG_PREFIX, () => APK_ASSET);
const pcRelease = latestRelease(releases, PC_TAG_PREFIX, (version) => `FAEVault_v${version}_Setup.exe`);
const ver = release ? release.tag_name!.slice(ANDROID_TAG_PREFIX.length) : FALLBACK_VERSION;
const pcVer = pcRelease ? pcRelease.tag_name!.slice(PC_TAG_PREFIX.length) : FALLBACK_VERSION;
const androidApk =
    release?.assets?.find((asset) => asset.name === APK_ASSET)?.browser_download_url
    ?? `https://github.com/faegit/faevault-site/releases/download/${ANDROID_TAG_PREFIX}${ver}/${APK_ASSET}`;
const releaseUrl = release?.html_url
    ?? `https://github.com/faegit/faevault-site/releases/tag/${ANDROID_TAG_PREFIX}${ver}`;
const pcReleaseBase = `https://github.com/faegit/faevault-site/releases/download/${PC_TAG_PREFIX}${pcVer}/`;
const pcSetupName = `FAEVault_v${pcVer}_Setup.exe`;
const pcSetup = pcRelease?.assets?.find((asset) => asset.name === pcSetupName)?.browser_download_url ?? pcReleaseBase + pcSetupName;
const pcCert = pcRelease?.assets?.find((asset) => asset.name === PC_CERT_ASSET)?.browser_download_url ?? pcReleaseBase + PC_CERT_ASSET;
const pcChecksums = pcRelease?.assets?.find((asset) => asset.name === CHECKSUM_ASSET)?.browser_download_url ?? pcReleaseBase + CHECKSUM_ASSET;
const pcReleaseUrl = pcRelease?.html_url ?? `https://github.com/faegit/faevault-site/releases/tag/${PC_TAG_PREFIX}${pcVer}`;

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const c =
    locale === "zh-cn"
        ? {
              kicker: "下载",
              title: "在你的设备上，继续掌控自己的资料。",
              intro: "FAEVault Android 与 Windows 正式版通过 GitHub Releases 发布。请选择对应设备的安装包。",
              androidBtn: "下载安装",
              windowsBtn: "下载安装",
              windowsCert: "下载签名证书",
              windowsChecksums: "下载校验文件",
              windowsTrust: "首次安装前，请核对校验文件与证书指纹，并自行信任签名证书；Windows 不会自动信任项目自签证书。",
              windowsRelease: "查看 Windows 发布说明",
              android: "Android 版本",
              windows: "Windows 版本",
              androidDetail: `版本 ${ver} · arm64-v8a / universal`,
              windowsDetail: `版本 ${pcVer} · x64 中文安装包`,
              notePre: "其他 CPU 架构（armeabi-v7a、x86_64、x86）请从 ",
              noteLink: "GitHub Releases",
              notePost: " 获取。",
              releaseUrl,
          }
        : {
              kicker: "Download",
              title: "Stay in control of your data on every device.",
              intro: "FAEVault for Android and Windows is published through GitHub Releases. Choose the installer for your device.",
              androidBtn: "Download and install",
              windowsBtn: "Download and install",
              windowsCert: "Download signing certificate",
              windowsChecksums: "Download checksums",
              windowsTrust: "Before your first installation, verify the checksums and certificate fingerprint, then explicitly trust the signing certificate. Windows does not automatically trust this self-signed certificate.",
              windowsRelease: "View Windows release notes",
              android: "Android version",
              windows: "Windows version",
              androidDetail: `Version ${ver} · arm64-v8a / universal`,
              windowsDetail: `Version ${pcVer} · x64 installer in Chinese`,
              notePre: "For other CPU architectures (armeabi-v7a, x86_64, x86), visit ",
              noteLink: "GitHub Releases",
              notePost: ".",
              releaseUrl,
          };
---

<PageShell theme="download" kicker={c.kicker} title={c.title} intro={c.intro}>
    <section class="platform-system">
        <div class="platform-orbits" aria-hidden="true"><i></i><i></i><b></b></div>
        <article class="android"><span>ANDROID</span><h2>{c.android}</h2><p>{c.androidDetail}</p><a class="dl-btn" href={androidApk} target="_blank" rel="noopener noreferrer">{c.androidBtn}</a></article>
        <article class="windows"><span>WINDOWS</span><h2>{c.windows}</h2><p>{c.windowsDetail}</p><a class="dl-btn" href={pcSetup} target="_blank" rel="noopener noreferrer">{c.windowsBtn}</a><p class="trust-note">{c.windowsTrust}</p><div class="release-assets"><a href={pcCert} target="_blank" rel="noopener noreferrer">{c.windowsCert}</a><a href={pcChecksums} target="_blank" rel="noopener noreferrer">{c.windowsChecksums}</a><a href={pcReleaseUrl} target="_blank" rel="noopener noreferrer">{c.windowsRelease}</a></div></article>
        <p class="release-note">{c.notePre}<a href={c.releaseUrl} target="_blank" rel="noopener noreferrer">{c.noteLink}</a>{c.notePost}</p>
    </section>
</PageShell>

<style>
    :global(.inner-page.theme-download) {
        padding-top: clamp(4.4rem, 8vw, 7rem);
    }
    @media (max-width: 760px) {
        :global(.inner-page.theme-download) {
            padding-top: clamp(4.2rem, 14vw, 5.5rem);
        }
    }
    .platform-system {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8rem;
        align-items: center;
        min-height: 610px;
        margin-top: 5rem;
        padding: 5rem 3rem;
    }
    .platform-orbits {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 560px;
        height: 390px;
        border: 1px solid rgba(52, 145, 124, 0.22);
        border-radius: 50%;
        transform: translate(-50%, -52%) rotate(-8deg);
        animation: orbit-breathe 5s ease-in-out infinite;
    }
    .platform-orbits i {
        position: absolute;
        inset: 48px -35px;
        border: 1px solid rgba(61, 145, 174, 0.2);
        border-radius: 50%;
        transform: rotate(17deg);
    }
    .platform-orbits i:nth-child(2) {
        inset: 105px -65px;
        transform: rotate(-14deg);
    }
    .platform-orbits b {
        position: absolute;
        left: 50%;
        top: -7px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #42a88f;
        box-shadow:
            0 0 0 8px rgba(66, 168, 143, 0.1),
            0 0 22px rgba(66, 168, 143, 0.55);
        animation: orbit-dot 6s linear infinite;
        transform-origin: 0 202px;
    }
    article {
        position: relative;
        z-index: 2;
        padding: 3rem;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 2rem;
        background: rgba(247, 252, 251, 0.65);
        box-shadow: 0 26px 70px rgba(45, 82, 94, 0.1);
        backdrop-filter: blur(18px);
        transition:
            transform 0.35s ease,
            box-shadow 0.35s ease;
        animation: platform-in 0.7s cubic-bezier(0.18, 0.78, 0.18, 1) both;
    }
    article.windows {
        animation-delay: 0.14s;
    }
    article:hover {
        transform: translateY(-8px) rotate(-0.5deg);
        box-shadow: 0 34px 85px rgba(45, 82, 94, 0.16);
    }
    article > span {
        color: #39846f;
        font-size: 0.65rem;
        letter-spacing: 0.16em;
    }
    h2 {
        margin: 1rem 0;
        color: #284550;
        font:
            500 2rem/1.1 Georgia,
            serif;
    }
    article p {
        color: #6b8088;
        font-size: 0.82rem;
    }
    .dl-btn {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.8rem 1.6rem;
        border: 0;
        border-radius: 99px;
        background: #287795;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
        pointer-events: auto;
    }
    .dl-btn:hover {
        background: #1f6079;
        transform: translateY(-2px);
    }
    .trust-note { max-width: 44ch; line-height: 1.6; }
    .release-assets { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: 1rem; }
    .release-assets a { color: #287795; font-size: 0.82rem; text-underline-offset: 3px; }
    .dl-btn.disabled {
        background: #dfe9e7;
        color: #71807e;
        pointer-events: none;
    }
    .release-note {
        position: absolute;
        left: 50%;
        bottom: 1.5rem;
        width: min(560px, 90%);
        color: #6b7f87;
        text-align: center;
        font:
            0.9rem/1.7 Georgia,
            serif;
        transform: translateX(-50%);
    }
    .release-note a {
        color: #287795;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
    }
    .release-note a:hover {
        color: #1a5f75;
    }
    .platform-withdrawn {
        position: relative;
        overflow: hidden;
        display: grid;
        place-items: center;
        min-height: 400px;
        margin-top: 5rem;
        padding: 5rem 3rem;
    }
    .withdrawn-card {
        position: relative;
        z-index: 2;
        max-width: 560px;
        padding: 3rem;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 2rem;
        background: rgba(247, 252, 251, 0.65);
        box-shadow: 0 26px 70px rgba(45, 82, 94, 0.1);
        backdrop-filter: blur(18px);
        text-align: center;
        animation: platform-in 0.7s cubic-bezier(0.18, 0.78, 0.18, 1) both;
    }
    .withdrawn-card > span {
        color: #39846f;
        font-size: 0.65rem;
        letter-spacing: 0.16em;
    }
    .withdrawn-card h2 {
        margin: 1rem 0;
        color: #284550;
        font:
            500 2rem/1.1 Georgia,
            serif;
    }
    .withdrawn-card p {
        color: #6b8088;
        font-size: 0.92rem;
        line-height: 1.7;
    }
    @keyframes platform-in {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.97);
        }
    }
    @keyframes orbit-breathe {
        50% {
            transform: translate(-50%, -52%) rotate(-3deg) scale(1.035);
        }
    }
    @keyframes orbit-dot {
        to {
            transform: rotate(360deg);
        }
    }
    @media (max-width: 800px) {
        .platform-system {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 4rem 0 7rem;
        }
        .platform-orbits {
            display: none;
        }
        .release-note {
            bottom: 1rem;
        }
    }
</style>


