---
import type { Locale } from "../i18n/config";
import PageShell from "./PageShell.astro";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const c =
    locale === "zh-cn"
        ? {
              kicker: "下载",
              title: "安装包已撤回。",
              intro: "当前仓库仅保留项目网页，暂不提供 Android 与 Windows 安装包下载。",
              label: "FAEVAULT",
              detail: "版本安装包、发布日志与校验文件均已从远端撤回。",
          }
        : {
              kicker: "Download",
              title: "Installers have been withdrawn.",
              intro: "This repository now hosts the project website only. Android and Windows installers are currently unavailable.",
              label: "FAEVAULT",
              detail: "All installers, release notes, and checksum files have been removed from the remote repository.",
          };
---

<PageShell theme="download" kicker={c.kicker} title={c.title} intro={c.intro}>
    <section class="platform-withdrawn">
        <div class="platform-orbits" aria-hidden="true"><i></i><i></i><b></b></div>
        <div class="withdrawn-card"><span>{c.label}</span><h2>{c.title}</h2><p>{c.detail}</p></div>
    </section>
</PageShell>

<style>
    :global(.inner-page.theme-download) {
        padding-top: clamp(4.4rem, 8vw, 7rem);
    }
    .platform-withdrawn {
        position: relative;
        overflow: hidden;
        display: grid;
        place-items: center;
        min-height: 400px;
        margin-top: 5rem;
        padding: 5rem 3rem;
    }
    .platform-orbits {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 560px;
        height: 390px;
        border: 1px solid rgba(52, 145, 124, 0.22);
        border-radius: 50%;
        transform: translate(-50%, -52%) rotate(-8deg);
        animation: orbit-breathe 5s ease-in-out infinite;
    }
    .platform-orbits i {
        position: absolute;
        inset: 48px -35px;
        border: 1px solid rgba(61, 145, 174, 0.2);
        border-radius: 50%;
        transform: rotate(17deg);
    }
    .platform-orbits i:nth-child(2) {
        inset: 105px -65px;
        transform: rotate(-14deg);
    }
    .platform-orbits b {
        position: absolute;
        left: 50%;
        top: -7px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #42a88f;
        box-shadow: 0 0 0 8px rgba(66, 168, 143, 0.1), 0 0 22px rgba(66, 168, 143, 0.55);
        animation: orbit-dot 6s linear infinite;
        transform-origin: 0 202px;
    }
    .withdrawn-card {
        position: relative;
        z-index: 2;
        max-width: 560px;
        padding: 3rem;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 2rem;
        background: rgba(247, 252, 251, 0.65);
        box-shadow: 0 26px 70px rgba(45, 82, 94, 0.1);
        backdrop-filter: blur(18px);
        text-align: center;
        animation: platform-in 0.7s cubic-bezier(0.18, 0.78, 0.18, 1) both;
    }
    .withdrawn-card > span {
        color: #39846f;
        font-size: 0.65rem;
        letter-spacing: 0.16em;
    }
    .withdrawn-card h2 {
        margin: 1rem 0;
        color: #284550;
        font: 500 2rem/1.1 Georgia, serif;
    }
    .withdrawn-card p {
        color: #6b8088;
        font-size: 0.92rem;
        line-height: 1.7;
    }
    @keyframes platform-in {
        from { opacity: 0; transform: translateY(30px) scale(0.97); }
    }
    @keyframes orbit-breathe {
        50% { transform: translate(-50%, -52%) rotate(-3deg) scale(1.035); }
    }
    @keyframes orbit-dot {
        to { transform: rotate(360deg); }
    }
    @media (max-width: 760px) {
        :global(.inner-page.theme-download) {
            padding-top: clamp(4.2rem, 14vw, 5.5rem);
        }
        .platform-withdrawn {
            margin-top: 3rem;
            padding: 4rem 0;
        }
        .platform-orbits {
            display: none;
        }
        .withdrawn-card {
            padding: 2.25rem 1.5rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .platform-orbits,
        .withdrawn-card {
            animation: none;
        }
    }
</style>
