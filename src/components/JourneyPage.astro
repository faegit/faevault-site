---
import type { Locale } from "../i18n/config";
import PageShell from "./PageShell.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = locale === "zh-cn"
  ? {
    kicker: "开发历程",
    title: "从为自己写一个工具开始。",
    story: [
      {
        title: "本地保险库的起点",
        paragraphs: [
          "最初版本已经包含多账户库、五种内置条目类型、scrypt + AES-256-GCM 加密、生物识别、Wi-Fi 二维码和 OCR 自动填表。",
          "保险库文件保存在 Android 应用私有目录中，系统备份被关闭；应用不提供开发者托管的账户或云端保险库。",
        ],
      },
      {
        title: "从管理条目到系统集成",
        paragraphs: [
          "3.2.2 版本加入 Android Autofill 服务与应用包名关联。当前实现支持原生应用登录表单，并对可确认来源的 HTTPS WebView 进行主机匹配。",
          "自动填充与 Credential Provider 是两套独立的 Android 系统能力；应用没有使用无障碍服务或悬浮窗来读取界面内容。",
        ],
      },
      {
        title: "同步、扫描与扩展资料",
        paragraphs: [
          "3.1.1 加入二维码和手动地址局域网同步，后续版本又加入系统文档提供程序与 WebDAV，同步时执行合并、并发检查和读回校验。",
          "银行卡与证件支持相机或相册图像的端上 OCR；Wi-Fi 与动态码模块支持对应二维码的扫描和解析。附件模块则把文件及 SHA-256 摘要随保险库一起加密。",
        ],
      },
      {
        title: "安全能力逐步补全",
        paragraphs: [
          "应用使用 FLAG_SECURE 保护敏感窗口，复制的敏感内容带有系统敏感标记并按设置的时间尝试清空；连续解锁失败会触发冷却。",
          "在线泄露检测启用时，应用只向 Pwned Passwords 服务发送 SHA-1 哈希前五位，再在本地比对完整结果。该功能可以在设置中关闭。",
        ],
      },
      {
        title: "当前版本",
        paragraphs: [
          "3.6.3 补全 Android 14+ Credential Manager Passkey Provider 的创建与断言流程；Passkey 作为独立条目保存、统计和同步。",
          "3.6.4 改进 WebDAV 原子上传、冲突检测与双目标自动同步调度。网站仅把已经出现在源码和更新日志中的能力列为现成功能。",
        ],
      },
    ],
  }
  : {
    kicker: "Development journey",
    title: "It started with building for myself.",
    story: [
      {
        title: "The local vault foundation",
        paragraphs: [
          "The initial release already included multiple vaults, five built-in entry types, scrypt + AES-256-GCM encryption, biometric unlock, Wi-Fi QR, and OCR-assisted fields.",
          "Vault files are stored in the Android app's private directory and system backup is disabled. The app does not provide a developer-hosted account or cloud vault.",
        ],
      },
      {
        title: "From entries to system integration",
        paragraphs: [
          "Version 3.2.2 added Android Autofill and app-package association. The current implementation supports native login forms and host matching for HTTPS WebViews whose origin can be confirmed.",
          "Autofill and Credential Provider are separate Android system integrations. The app does not use accessibility services or floating windows to read interfaces.",
        ],
      },
      {
        title: "Sync, scanning, and richer data",
        paragraphs: [
          "Version 3.1.1 added QR and manual-address LAN sync. Later releases added system document providers and WebDAV, with merge, concurrency checks, and read-back verification.",
          "Cards and IDs support on-device OCR from camera or gallery images. Wi-Fi and OTP modules parse their corresponding QR formats, while attachments store files and SHA-256 digests inside the encrypted vault.",
        ],
      },
      {
        title: "Security capabilities",
        paragraphs: [
          "FLAG_SECURE protects sensitive windows. Copied secrets are marked sensitive and cleared after the configured interval when possible, while repeated unlock failures trigger cooldowns.",
          "When online breach checking is enabled, only the first five characters of a SHA-1 hash are sent to Pwned Passwords; complete matching is performed locally. The feature can be disabled.",
        ],
      },
      {
        title: "Current releases",
        paragraphs: [
          "Version 3.6.3 completed Android 14+ Credential Manager flows for passkey creation and assertions. Passkeys are stored, counted, and synced as a separate entry type.",
          "Version 3.6.4 improved WebDAV atomic uploads, conflict checks, and dual-target automatic sync scheduling. This site lists a feature as available only when it is present in source or release notes.",
        ],
      },
    ],
  };
---
<PageShell theme="journey" kicker={c.kicker} title={c.title} intro="">
  <section class="story-field">
    <div class="story-container">
      {
        c.story.map((chapter, idx) => (
          <article class="story-chapter" style={`--i:${idx}`}>
            <h2>{chapter.title}</h2>
            {chapter.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </article>
        ))
      }
    </div>
  </section>
</PageShell>

<style>
  .story-field {
    max-width: 800px;
    margin: 5rem auto 0;
  }
  .story-container {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(71, 106, 122, 0.1);
    border-radius: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
    box-shadow: 0 8px 30px rgba(41, 81, 95, 0.06);
    display: grid;
    gap: 4rem;
  }
  .story-chapter {
    opacity: 1;
    animation: fadeIn 0.7s calc(0.08s + var(--i) * 0.1s) cubic-bezier(0.18, 0.78, 0.18, 1);
  }
  .story-chapter h2 {
    margin: 0 0 1.2rem;
    color: #173f50;
    font: 500 clamp(1.4rem, 3vw, 2rem)/1.15 Georgia, serif;
    letter-spacing: -0.03em;
  }
  .story-chapter p {
    color: #4f6974;
    font: 0.98rem/1.85 Georgia, serif;
    margin: 0 0 1rem;
  }
  .story-chapter p:last-child {
    margin-bottom: 0;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
  }
  @media (max-width: 760px) {
    .story-field { margin-top: 3rem; }
    .story-container { gap: 2.5rem; padding: 1.5rem; border-radius: 1.3rem; }
  }
</style>
