---
import type { Locale } from "../i18n/config";
import "../styles/beyond-passwords.css";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === "zh-cn";
const copy = zh
    ? {
          kicker: "不止管理密码",
          title: "把更多重要内容，放进同一个保险库",
          body: "除了登录密码，保险库还内置证件、Wi-Fi、动态码等独立条目模块。每种类型都有对应的字段与展示方式，和登录条目一样在本地加密文件中管理。",
          stackLabel: "模块卡片轮播",
          stackHint: "点击或按回车查看下一项",
          modules: [
              { icon: "id", title: "证件", body: "身份证等证件条目集中保存，按需查看详细信息；敏感字段受二次验证保护。" },
              { icon: "wifi", title: "Wi-Fi", body: "保存 SSID 与密码，并支持扫码快速分享或连接，凭证同样本地加密。" },
              { icon: "otp", title: "动态码", body: "为支持 TOTP 的账户保存动态验证码，打开即显示当前口令，无需额外验证器应用。" },
              { icon: "image", title: "图片", body: "在条目中保存并预览图片，也能随 Markdown 文档内嵌展示，文件随条目本地加密。" },
              { icon: "attachment", title: "附件", body: "为任意条目附加文件，本地加密保存，按需导出或在条目内直接查看。" },
              { icon: "markdown", title: "Markdown", body: "用 Markdown 记录长篇笔记，支持代码块与表格，后台解析、打开即读。" },
          ],
      }
    : {
          kicker: "Beyond passwords",
          title: "Keep more of what matters in one vault",
          body: "Beyond login passwords, the vault ships independent entry modules for IDs, Wi-Fi, and one-time codes. Each type has its own fields and presentation, and is managed in the same locally encrypted file as your logins.",
          stackLabel: "Module cards carousel",
          stackHint: "Click or press Enter to view the next item",
          modules: [
              { icon: "id", title: "ID cards", body: "ID entries are stored in one place and revealed on demand; sensitive fields are protected by re-verification." },
              { icon: "wifi", title: "Wi-Fi", body: "Save the SSID and password, and share or connect via QR code — credentials stay locally encrypted." },
              { icon: "otp", title: "One-time codes", body: "Keep TOTP codes for supported accounts; the current code shows as soon as you open the entry, no separate authenticator needed." },
              { icon: "image", title: "Images", body: "Save and preview images inside an entry, or embed them in a Markdown document; files are encrypted with the entry." },
              { icon: "attachment", title: "Attachments", body: "Attach files to any entry; they are stored encrypted locally and can be exported or viewed on demand." },
              { icon: "markdown", title: "Markdown", body: "Write long notes in Markdown with code blocks and tables; parsing happens in the background so they open instantly." },
          ],
      };

const icons: Record<string, string> = {
    id: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="11" r="2"/><path d="M13.5 9.5h4M13.5 13h4M6 15.5h7"/></svg>`,
    wifi: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5a13 13 0 0 1 16 0"/><path d="M7 13a8.5 8.5 0 0 1 10 0"/><path d="M9.5 16.2a4.5 4.5 0 0 1 5 0"/><circle cx="12" cy="19" r="1.1" fill="currentColor" stroke="none"/></svg>`,
    otp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 16"/><path d="M4 20v-4h4"/></svg>`,
    image: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M21 16l-5-5-7 7"/></svg>`,
    attachment: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5l-8.2 8.2a3.6 3.6 0 0 1-5.1-5.1l8.2-8.2a2.3 2.3 0 0 1 3.3 3.3l-8.2 8.2a1 1 0 0 1-1.4-1.4l7.5-7.5"/></svg>`,
    markdown: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M6 15V9l3 3 3-3v6"/><path d="M16 9v6M16 14l2-2 2 2"/></svg>`,
};
---

<section class="bp-section" id="beyond-passwords">
    <div class="bp-shell">
        <div class="bp-copy">
            <div class="eyebrow-pill bp-kicker"><span class="eyebrow-dot"></span>{copy.kicker}</div>
            <h2>{copy.title}</h2>
            <p class="bp-intro">{copy.body}</p>
        </div>
        <div class="bp-modules" data-feature-stack data-stack-card=".bp-module" data-stack-title="h3" data-stack-role={zh ? "轮播" : "carousel"} data-stack-label={copy.stackLabel} data-stack-hint={copy.stackHint}>
            {
                copy.modules.map((m) => (
                    <article class="bp-module">
                        <span class="bp-module-icon" aria-hidden="true" set:html={icons[m.icon]} />
                        <h3>{m.title}</h3>
                        <p>{m.body}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
