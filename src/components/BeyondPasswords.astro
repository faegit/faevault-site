---
import type { Locale } from "../i18n/config";
import "../styles/beyond-passwords.css";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === "zh-cn";
const copy = zh
    ? {
          kicker: "不止管理密码", title: "把更多重要内容，放进同一个保险库",
          body: "图片、附件与 Markdown 可以和密码条目一起整理。长篇文档、大段代码和大量文本在后台解析，并按内容块逐步呈现，让阅读与滚动保持从容。",
          capabilities: ["图片", "附件", "Markdown"],
          mechanisms: [
              { icon: "01", title: "后台解析", body: "Markdown 解析离开界面主线程，减少打开长文档时的阻塞。" },
              { icon: "02", title: "渐进渲染", body: "正文与长代码分块呈现，列表按需加载当前需要显示的内容。" },
              { icon: "03", title: "按需读取", body: "图片和附件以分块方式读写、校验并按需解密，避免一次性展开全部数据。" },
          ],
      }
    : {
          kicker: "Beyond passwords", title: "Keep more of what matters in one vault",
          body: "Organize images, attachments, and Markdown alongside your password entries. Long documents, large code blocks, and text-heavy notes are parsed in the background and revealed progressively, keeping reading and scrolling responsive.",
          capabilities: ["Images", "Attachments", "Markdown"],
          mechanisms: [
              { icon: "01", title: "Background parsing", body: "Markdown parsing runs away from the UI thread to reduce blocking when opening long documents." },
              { icon: "02", title: "Progressive rendering", body: "Documents and long code blocks are rendered in chunks, while lazy lists load only the content currently needed." },
              { icon: "03", title: "On-demand access", body: "Images and attachments are streamed, verified, and decrypted in chunks instead of expanding all data at once." },
          ],
      };
---

<section class="bp-section" id="beyond-passwords">
    <div class="bp-shell">
        <div class="bp-copy">
            <div class="eyebrow-pill bp-kicker"><span class="eyebrow-dot"></span>{copy.kicker}</div>
            <h2>{copy.title}</h2>
            <p class="bp-intro">{copy.body}</p>
            <ul class="bp-capabilities" aria-label={copy.kicker}>{copy.capabilities.map((item) => <li>{item}</li>)}</ul>
            <div class="bp-mechanisms">
                {copy.mechanisms.map((item) => (
                    <article class="bp-mechanism">
                        <span aria-hidden="true">{item.icon}</span>
                        <div><h3>{item.title}</h3><p>{item.body}</p></div>
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>
